Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"83a0077c-62b3-414f-a7b8-8f94f65032cd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77615ef4-4fae-4d0d-b50b-719c57d5c17e"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once. It is a symbolic object; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c6ca716-cf6d-4d0a-8d03-184b4e3e0958"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "39bc4d33-f9c3-48cc-9c0e-6c14355e9835"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"733cfd63-6913-4a87-9d94-f6ba1d090eaf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e222a20-b73f-442d-b0a5-5bc9d6e9a7f5"],
 "\[LineSeparator]",
 "is the polyline of the segments [",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "], \[Ellipsis], [",
 StyleBox["p(k-1)", "TI"],
 ", ",
 StyleBox["pk", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5ea81cd2-a809-4082-8fc5-2653416525f5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5ed1dd3-3057-41cd-84d9-266a77e939f3"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9cd6dd1b-b7a2-4d37-96e4-1bcfe7d405a6"],
 " is the segment construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2cf5f72c-6f10-4d84-9746-5f7b46b09fe5"],
 " is the search."
}], "Usage",ExpressionUUID->"ee9dc953-ae7a-4d72-91d5-9c3952f33d47"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the set of all shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"c0c0ceeb-aea3-476a-80b0-1b0efc95a819"],

Cell["\<\
It carries no weights. The shortest paths are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"1d195b25-c0d4-438b-8fcc-4e4753cf75f4"],

Cell[TextData[{
 "The head holds its two points and computes nothing. Its graph \[LongDash] \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "65054738-27d3-43fd-832a-c8f2e1b04ae9"],
 " \[LongDash] is the interval of shortest paths: the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(p, v) + d(v, q) = d(p, q)", "TI"],
 ", with arrows of rising distance from ",
 StyleBox["p", "TI"],
 ". Its source-to-sink chains are exactly the shortest paths, each once, so \
",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "191a02af-eb59-4658-bfd3-e4df9d32d6cd"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80c8eb2c-3e81-4780-b039-70b70bd537e8"],
 "."
}], "Notes",ExpressionUUID->"385f7305-6c32-408b-9a38-4af42d790a2b"],

Cell["\<\
Every count is read off that graph by dynamic programming, never by \
enumeration. The graph stays small where the family is large: two vertices at \
distance 5 on a square grid have 10 shortest paths and a 12-vertex graph.\
\>", "Notes",ExpressionUUID->"5ee735a6-1f0f-43f7-a3de-3ec49ca06984"],

Cell[TextData[{
 "A polyline is the one head whose ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02975049-e59a-43eb-9375-403915ba9b3a"],
 " of graphs is not a family of alternatives. Its members are concatenations \
of one shortest path per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "300b9e3e-6434-41ae-8bdc-216508d36467"],
 " is the product over the pieces and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09e54e30-ed34-4c34-9ea1-84b88d628811"],
 " the sum. Its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bac3e17c-74eb-4b2c-8dc7-1bb519d8309c"],
 " stays the sum of the piece densities."
}], "Notes",ExpressionUUID->"7ddb1929-7729-477e-ad7b-47a0fb911782"],

Cell[TextData[{
 "The support of the segment, the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1cdc2b2d-b6d3-4b72-9e27-d359916248d6"],
 ", is the interval itself. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1129cea6-85aa-4f81-be68-fd77d3a6d578"],
 " gives two measures of it:"
}], "Notes",ExpressionUUID->"c59911f2-7f95-4f0e-8cb2-f71e17f8ab01"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "419b134f-8936-424c-9a8c-eef12b0dc81d"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"882316cc-a1b9-4e81-b166-acb6b3229126"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"da3c95d8-5c3a-4b89-b7ae-40247932ee4a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f2bae548-25a7-4a09-9eff-7bc308064d46"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "aed6fe77-778c-41e8-9377-73efa279cd42"]], "TableText",ExpressionUUID->
     "b3b042e6-1d96-4dbf-b62f-71134c0cdb68"], Cell[
    "the number of vertices of the interval", "TableText",ExpressionUUID->
     "916fda8d-8473-4469-98f5-f0b07895ca90"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6f3dff97-6c5a-42db-9ce6-6fc955680959"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "5023acea-fd78-4052-a59b-fe72f89c6f1c"]], "TableText",ExpressionUUID->
     "ed0ea28e-febf-4381-b720-f5ea5410a5a9"], Cell["\<\
the number of vertices of the interval all of whose neighbours lie in it\
\>", "TableText",ExpressionUUID->"7096bee5-f940-4cd8-9bfa-e1af099006fa"]}
  }]], "2ColumnTableMod",ExpressionUUID->"3312e7e8-a7b6-4c51-95b1-\
1257d504447b"],

Cell[TextData[{
 "On the square grid two vertices ",
 StyleBox["a", "TI"],
 " steps apart along one axis and ",
 StyleBox["b", "TI"],
 " along the other span an (",
 StyleBox["a", "TI"],
 " + 1) \[Times] (",
 StyleBox["b", "TI"],
 " + 1) rectangle, so for ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 " \[GreaterEqual] 1 the measures are (",
 StyleBox["a", "TI"],
 " + 1)(",
 StyleBox["b", "TI"],
 " + 1) and (",
 StyleBox["a", "TI"],
 " \[Minus] 1)(",
 StyleBox["b", "TI"],
 " \[Minus] 1). A segment with a single shortest path is all boundary, and \
its Riemannian measure is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "217a4f6c-c362-4f08-b922-d47a5bd5a807"],
 ". The rim of the graph is not boundary: a segment whose interval is the \
whole graph has both measures equal to the number of vertices."
}], "Notes",ExpressionUUID->"9b1937c1-0687-457e-8751-7f4acf8a5d05"],

Cell[TextData[{
 "A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "282bc011-99d4-49db-bd5d-0234b0aea428"],
 " reads one, several or all of them, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34e24786-fc73-4031-b002-287989f431bf"],
 " tests one."
}], "Notes",ExpressionUUID->"47c9c395-418c-4161-a05a-4aff6dc27614"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"9f2f2dad-5582-4f89-b1cc-c7bddca78c3f"],

