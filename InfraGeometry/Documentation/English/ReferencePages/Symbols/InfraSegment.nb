Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58f61ede-495b-4b8f-9853-1fed2b4b2788"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b55bbe9f-e6bf-4ab9-897a-70591e2e32f2"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": the family of all shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b713eea6-5b6e-4609-92b2-e976901c6826"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a195ed1-e83e-49fe-99a5-d89f898eca82"],
 "\[LineSeparator]",
 "is the polyline through ",
 StyleBox["p1", "TI"],
 ", \[Ellipsis], ",
 StyleBox["pk", "TI"],
 ": a shortest path from each point to the next, joined."
}], "Usage",ExpressionUUID->"20711fba-0c05-4f20-84d1-759990738331"],

Cell[TextData[{
 "A member of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed5b5124-15d4-4dfe-a425-2171eaaf7f54"],
 " is a shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ". All members have length ",
 StyleBox["d(p, q)", "TI"],
 ", and none is preferred."
}], "Notes",ExpressionUUID->"1170a01b-53aa-4830-b8bd-9da6f3cc18a9"],

Cell[TextData[{
 "The vertices on the members form the metric interval ",
 StyleBox["I(p, q) = {v : d(p, v) + d(v, q) = d(p, q)}", "TI"],
 ", the support of the segment."
}], "Notes",ExpressionUUID->"88533091-8da1-4031-b370-65df707fef32"],

Cell[TextData[{
 "A segment can have many members. On the square grid, with ",
 StyleBox["a", "TI"],
 " steps from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " along one axis and ",
 StyleBox["b", "TI"],
 " along the other, there are ",
 StyleBox["C(a + b, a)", "TI"],
 " shortest paths, and the interval is the (",
 StyleBox["a", "TI"],
 " + 1) \[Times] (",
 StyleBox["b", "TI"],
 " + 1) rectangle with corners ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"d4df7c2b-d447-4280-9985-f3205b004fbb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9ad98bde-088c-434f-a558-fa2524e7cfb8"],
 " is a symbolic object: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8ca55530-a849-4658-b45b-b85d5ea698a9"],
 " evaluates it on a graph, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["RandomInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/RandomInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9216283e-e460-48dc-9784-245a93d85e7f"],
 " draws members and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3cc7ecc0-68fc-4b38-8f01-dcd62329be87"],
 " tests one. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrateHighlight"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrateHighlight", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a4142bc4-8af1-45fb-859e-e468b2415900"],
 " draws all members at once, an edge the stronger the more members use it."
}], "Notes",ExpressionUUID->"87c090a8-59ab-4db2-a02e-bea142762ad7"],

