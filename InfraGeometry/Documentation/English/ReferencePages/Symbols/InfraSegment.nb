Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5212ff79-2460-485c-8f5c-1327e5bf3c70"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e6119c87-c605-4384-8dbd-e4d22737eaa8"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f069684e-d87c-4c81-8bf3-76572bebf377"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b169dc14-bffc-45c9-86a7-adf5969c74ea"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9bfdce5c-2848-4886-83a8-b4b7f0d54bd6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c594da4b-30fd-4340-b5f3-478e258d3ea5"],
 "\[LineSeparator]",
 "is the polyline of the segments [",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "], \[Ellipsis], [",
 StyleBox["p(k-1)", "TI"],
 ", ",
 StyleBox["pk", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0c86760a-1358-4348-b4a0-a27a011a51d8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46c9a2a9-e964-4774-9bf7-300f1ac549e3"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18304bcf-fe08-4f7a-b1f9-5a83c0cb3260"],
 " is the segment construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "53e16d16-959e-4110-b768-9ff4c3848f22"],
 " is the search."
}], "Usage",ExpressionUUID->"f48f1d13-f647-4a84-b0a5-c3dfbad8eda2"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the set of all shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"9c32184f-3a62-426f-8c04-bcda1418ea09"],

Cell["\<\
It carries no weights. The shortest paths are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"a101f19c-80a5-4903-88ef-98877e8da635"],

Cell[TextData[{
 "The head holds its two points and computes nothing. Its graph \[LongDash] \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8dbf88dc-f052-4ef5-baac-1fe6b95cf7ac"],
 " \[LongDash] is the interval of shortest paths: the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(p, v) + d(v, q) = d(p, q)", "TI"],
 ", with arrows of rising distance from ",
 StyleBox["p", "TI"],
 ". Its source-to-sink chains are exactly the shortest paths, each once, so \
",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d07b775f-9ebb-4f86-87c6-7a90a76f55d6"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "014e711b-c99d-459f-ada3-352fa798edc9"],
 "."
}], "Notes",ExpressionUUID->"04d8b2da-677e-4b06-8430-8462e91a768a"],

Cell["\<\
Every count is read off that graph by dynamic programming, never by \
enumeration. The graph stays small where the family is large: two vertices at \
distance 5 on a square grid have 10 shortest paths and a 12-vertex graph.\
\>", "Notes",ExpressionUUID->"a84f2a70-9446-4d4a-afae-3989eb3c5755"],

Cell[TextData[{
 "A polyline is the one head whose ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f4581a1-0bfa-4ee6-9593-e1a5812aebdd"],
 " of graphs is not a family of alternatives. Its members are concatenations \
of one shortest path per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa485767-a227-4b09-928f-bfab530c3361"],
 " is the product over the pieces and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a72ef3e1-7909-45ef-b855-1e631683cce7"],
 " the sum. Its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce181bbe-2fb1-4264-a4e3-b526991e4622"],
 " stays the sum of the piece densities."
}], "Notes",ExpressionUUID->"e6ab5be7-96e7-43ef-961f-b020ad1f2394"],

Cell[TextData[{
 "A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "372e14e4-696a-4309-9e35-571708b67fd0"],
 " reads one, several or all of them, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7c1a53a1-e904-4775-9fc1-38ac23eabe40"],
 " tests one."
}], "Notes",ExpressionUUID->"aef1478e-b0db-4967-9749-5666d81494ba"]
}, Open  ]],

