Cell["The graph is small where the family is large.", "ExampleText",ExpressionUUID->"f14bc642-9b6e-40fc-92e9-b1fb8bee7ba9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<geodesics\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Length\>\""}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"\"\<graph vertices\>\"", " ", "->", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], 
        "]"}]}]}]}], "|>"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"aca8e641-d0c6-47be-bc72-34c4d5a2aa0c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"geodesics\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"length\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"graph vertices\"\>", "\[Rule]", "12"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"379376ac-f2ce-4eec-96df-122d4619ce55"]
}, Open  ]],

