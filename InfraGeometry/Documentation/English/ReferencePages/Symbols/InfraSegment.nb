Cell["\<\
The interval of the same segments, its inner vertices in green and its \
boundary in blue. The Riemannian measure counts the green ones, the counting \
measure both. On the square grid the interval is a 3 \[Times] 4 rectangle \
with 2 inner vertices. On the discretized plane the two shortest paths differ \
in a single vertex, and nothing is inside.\
\>", "ExampleText",ExpressionUUID->"0ae295ce-909c-4e43-8c61-dba3c2f1b20c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"InfraCenter", "[", "g", "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"seg", " ", "=", " ", 
        RowBox[{"InfraSegment", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
            RowBox[{"RandomInfraPoint", "[", 
             RowBox[{"g", ",", " ", "c", ",", " ", "5"}], "]"}]}], ")"}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"support", " ", "=", " ", 
        RowBox[{"Keys", " ", "@", " ", 
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<VertexDensity\>\""}], 
          "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSubstrateHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"InfraInterior", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardGreen"}], ",", " ", 
            RowBox[{
             RowBox[{"InfraBoundary", "[", 
              RowBox[{"g", ",", " ", "support"}], "]"}], " ", "->", " ", 
             "StandardBlue"}]}], "}"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{"InfraMeasurement", "[", 
         RowBox[{"g", ",", " ", "seg", ",", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Cardinality\>\"", ",", " ", "\"\<CountingMeasure\>\"",
             ",", " ", "\"\<RiemannianMeasure\>\""}], "}"}]}], "]"}]}], 
       "]"}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"868e550e-70b7-4d59-9d2f-8b50302446af"],

