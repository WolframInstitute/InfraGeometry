Cell["The graph is small where the family is large.", "ExampleText",ExpressionUUID->"a6dcbcf1-981e-4f93-b18d-ca6684fdf76d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<geodesics\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Cardinality\>\""}], 
       "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Length\>\""}], "]"}]}], ",",
      "\n", "    ", 
     RowBox[{"\"\<graph vertices\>\"", " ", "->", " ", 
      RowBox[{"VertexCount", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", "seg", ",", " ", "\"\<Graph\>\""}], 
        "]"}]}]}]}], "|>"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"13b98f57-007b-49fc-b1ba-eed752c91e84"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"geodesics\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"length\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"graph vertices\"\>", "\[Rule]", "12"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"b1665db9-7dd6-421e-b0be-dda26e7db2a3"]
}, Open  ]],

