      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"poly", " ", "=", " ", 
     RowBox[{"InfraSegment", "[", 
      RowBox[{"1", ",", " ", "13", ",", " ", "25"}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<Cardinality\>\""}], "]"}],
      ",", " ", 
     RowBox[{"InfraMeasurement", "[", 
      RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<Length\>\""}], "]"}], ",",
      "\n", "   ", 
     RowBox[{
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", "poly", ",", " ", "\"\<VertexDensity\>\""}], 
       "]"}], "[", "13", "]"}]}], "}"}]}], "\n", "]"}]], "Input",
