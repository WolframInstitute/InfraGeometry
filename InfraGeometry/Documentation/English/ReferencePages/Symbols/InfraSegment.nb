Notebook[{

Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"73dca830-73c7-4c73-9263-a74995d2308d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aad6ed50-6cec-4727-bfc8-97924aad0b60"],
 "\[LineSeparator]",
 "is the segment from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 ": every shortest path from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 " at once. It is inert; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aeadb96c-57ef-459e-a422-e0a05a8aab92"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a54267e7-342b-4f34-942b-90ce49dffe43"],
 " evaluate it on a graph.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ee23ba6b-1072-4151-87ef-2929412a0f3f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["pk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4633ce70-f957-4e95-92c8-23e438b54748"],
 "\[LineSeparator]",
 "is the polyline of the segments [",
 StyleBox["p1", "TI"],
 ", ",
 StyleBox["p2", "TI"],
 "], \[Ellipsis], [",
 StyleBox["p(k-1)", "TI"],
 ", ",
 StyleBox["pk", "TI"],
 "].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"574f5c9e-15a9-4951-838d-0c3f6974ca69"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraSegment", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["p", "TI"], ",", " ", 
    StyleBox["q", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42a52f7a-73c8-4cb5-9710-3ec10c343456"],
 "\[LineSeparator]",
 "inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraScene", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b302c6ad-dcf1-4153-9e67-c6ff51a573ec"],
 " is the segment construction token; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSegment", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6b56ecc-f872-4133-af73-aebea3ba570a"],
 " is the search."
}], "Usage",ExpressionUUID->"b45e5bf5-9f59-4004-a8bc-04ddc5fd9c9f"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["p", "TI"],
 " and ",
 StyleBox["q", "TI"],
 " is the set of all shortest paths from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q", "TI"],
 "."
}], "Notes",ExpressionUUID->"14e344cb-3c3d-4162-bbef-6900ceef97ea"],

Cell["\<\
It carries no weights. The shortest paths are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"b4d4dfa6-46df-4c3a-ae58-e157d883acf9"],

Cell[TextData[{
 "The head holds its two points and computes nothing. Its graph \[LongDash] \
",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMeasurement"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", "\"\<Graph\>\""}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c305f495-e57d-4057-adf7-dcdc33d5fa8f"],
 " \[LongDash] is the interval of shortest paths: the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["d(p, v) + d(v, q) = d(p, q)", "TI"],
 ", with arrows of rising distance from ",
 StyleBox["p", "TI"],
 ". Its source-to-sink chains are exactly the shortest paths, each once, so \
",
 Cell[BoxData["\"\<Faithful\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b8b790d6-8968-49af-b598-c9899fc37367"],
 " is ",
 Cell[BoxData["True"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c066ce08-0faa-4bee-bc58-9d6ca6263399"],
 "."
}], "Notes",ExpressionUUID->"a8c28431-fcfa-4c2b-af8b-5169e4f8c446"],

Cell["\<\
Every count is read off that graph by dynamic programming, never by \
enumeration. The graph stays small where the family is large: two vertices at \
distance 5 on a square grid have 10 shortest paths and a 12-vertex graph.\
\>", "Notes",ExpressionUUID->"bb725acf-8b89-44d8-a24a-dfb2eef767ba"],

Cell[TextData[{
 "A polyline is the one head whose ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3e7cab1-9650-48ab-b253-f7a57f404b21"],
 " of graphs is not a family of alternatives. Its members are concatenations \
of one shortest path per piece, so its ",
 Cell[BoxData["\"\<Cardinality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab34b478-9210-48d3-be06-2f78f20b1d31"],
 " is the product over the pieces and its ",
 Cell[BoxData["\"\<Length\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aeeb72a9-bb85-486b-9de0-9db1d9ac6e13"],
 " the sum. Its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82758929-2cd0-4fb5-9965-b395c350302e"],
 " stays the sum of the piece densities."
}], "Notes",ExpressionUUID->"6010895d-7a5f-4dac-b758-5404528d9ae7"],

Cell[TextData[{
 "The support of the segment, the keys of its ",
 Cell[BoxData["\"\<VertexDensity\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca71fbf-34e4-48df-8136-32a2ac8a6696"],
 ", is the interval itself. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c64841ce-83ea-4e70-9f72-e540879b4b00"],
 " gives two measures of it:"
}], "Notes",ExpressionUUID->"5ab809bc-a80e-4a04-820e-b0cb89f43780"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d2f304d5-cb40-4976-b5ab-7743088285a2"], Cell["Measure", "TableText",
     FontWeight->Bold,ExpressionUUID->"39bc7b19-3c4b-438e-9df4-ec2b5c5c7ca2"],
     Cell["Value", "TableText",
     FontWeight->Bold,ExpressionUUID->"ff7b1544-607c-4ddb-8a51-dd080438a14a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0f4b9b35-da28-42c4-9811-3e12e9f140bd"], Cell[TextData[Cell[
    BoxData["\"\<CountingMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "45bcc5f7-f3e0-4a78-ad79-00963a0b3bc7"]], "TableText",ExpressionUUID->
     "2e23db0f-abf4-4ba9-9ecb-15fc5f54ec05"], Cell[
    "the number of vertices of the interval", "TableText",ExpressionUUID->
     "495a6f6c-db97-4c60-9b7b-0f0d95fd79a9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e255b5cd-4b5d-4a90-95d3-c6a5289d26e0"], Cell[TextData[Cell[
    BoxData["\"\<RiemannianMeasure\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b49f16cd-06ae-42d8-9ec9-4a37a3410f0b"]], "TableText",ExpressionUUID->
     "39c29ee5-735d-46f1-98ed-794b65ebc585"], Cell["\<\
the number of vertices of the interval all of whose neighbours lie in it\
\>", "TableText",ExpressionUUID->"0f965226-3e84-4776-9f12-6c39e78c795f"]}
  }]], "2ColumnTableMod",ExpressionUUID->"e0d8cf68-b3ad-4ba3-9958-\
eda546ab32fa"],

Cell[TextData[{
 "On the square grid two vertices ",
 StyleBox["a", "TI"],
 " steps apart along one axis and ",
 StyleBox["b", "TI"],
 " along the other span an (",
 StyleBox["a", "TI"],
 " + 1) \[Times] (",
 StyleBox["b", "TI"],
 " + 1) rectangle, so for ",
 StyleBox["a", "TI"],
 ", ",
 StyleBox["b", "TI"],
 " \[GreaterEqual] 1 the measures are (",
 StyleBox["a", "TI"],
 " + 1)(",
 StyleBox["b", "TI"],
 " + 1) and (",
 StyleBox["a", "TI"],
 " \[Minus] 1)(",
 StyleBox["b", "TI"],
 " \[Minus] 1). A segment with a single shortest path is all boundary, and \
its Riemannian measure is ",
 Cell[BoxData["0"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ff820cf-8ee1-4638-acb1-ce521fa5174f"],
 ". The rim of the graph is not boundary: a segment whose interval is the \
whole graph has both measures equal to the number of vertices."
}], "Notes",ExpressionUUID->"a23b45bc-ff7f-4499-9043-87291518a0c3"],

Cell[TextData[{
 "A member is a vertex list; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "98a3fa33-1be0-4acf-8832-466cc09a013f"],
 " reads one, several or all of them, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMemberQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMemberQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f323b999-9952-4f70-a91e-cc31cd5422e0"],
 " tests one."
}], "Notes",ExpressionUUID->"efaeab4d-ffa7-42eb-a478-60fca19be4cd"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"4ae91b2c-0396-4f58-95e7-5972cd3abd4c"],

