Cell["\<\
The Levi-Civita connection of the displacement bundle is not a connection on \
the square grid, where the fibers at the rim have one vertex and the others \
four. On the square torus, with no rim, it is:\
\>", "ExampleText",ExpressionUUID->"b28434d7-cbe8-4efe-a1e8-b7fc605632cf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fib", " ", "=", " ", 
       RowBox[{"InfraDisplacementBundle", "[", 
        RowBox[{
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}], ",", " ", "1"}],
         "]"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"FindInfraLeviCivitaConnection", "[", "fib", "]"}]}], "]"}]}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareTorusGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3a2dd0c6-e611-4036-b401-8779aaa5c0d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"c9c4184d-bf2b-4853-8803-e3cbaad22eb0"]
}, Open  ]]
}, Open  ]],

