Cell["\<\
The horizontal edges of the prism are a connection. Without one of them they \
are not: its two endpoints, drawn, lose a lift.\
\>", "ExampleText",ExpressionUUID->"8b41e3e6-6a00-4177-a2f0-5b444e4f859a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"horizontal", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"List", " ", "@@", " ", 
           RowBox[{"First", " ", "@", " ", "horizontal"}]}]}], "]"}], "}"}]}],
       "]"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", "horizontal", "]"}]}], "]"}], ",", " ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", 
        RowBox[{"Rest", " ", "@", " ", "horizontal"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"bede1ded-d391-45a0-bccd-bbe7788961ec"],

