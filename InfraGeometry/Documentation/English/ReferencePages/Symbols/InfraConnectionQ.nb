    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraConnection", "[", 
     StyleBox["edges", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "106e1f60-7c89-40ac-a904-b4040974a6f4"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["edges", "TI"],
 " are horizontal total edges giving exactly one lift wherever the total \
graph has one.",
 "\n"
}], "Usage",ExpressionUUID->"aa25dddf-b3be-4268-b086-7de07de84a15"],

Cell["\<\
Every edge must be an edge of the total graph between two different fibers.\
\>", "Notes",ExpressionUUID->"e8341f5e-4324-40cc-b124-65d8e6f221c6"],

Cell[TextData[{
 "At every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 ", the edges at ",
 StyleBox["x", "TI"],
 " must lie over every base neighbour of ",
 StyleBox["p", "TI"],
 " that the total graph reaches from ",
 StyleBox["x", "TI"],
 ", each exactly once."
}], "Notes",ExpressionUUID->"cb0a68b0-367f-4bc6-b2f0-109b56c7f6d6"]
}, Open  ]],

