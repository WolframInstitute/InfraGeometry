  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"InfraConnection", "[", 
     StyleBox["edges", "TI"], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74a58233-f446-4a68-bb15-89b5c5a1aac0"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["edges", "TI"],
 " are horizontal total edges giving exactly one lift wherever the total \
graph has one.",
 "\n"
}], "Usage",ExpressionUUID->"623874b3-afef-4e25-a897-cf9cdffb911a"],

Cell["\<\
Every edge must be an edge of the total graph between two different fibers.\
\>", "Notes",ExpressionUUID->"36d35142-ee99-4277-a2a1-da30582fbdc7"],

Cell[TextData[{
 "At every total vertex ",
 StyleBox["x", "TI"],
 " over ",
 StyleBox["p", "TI"],
 ", the edges at ",
 StyleBox["x", "TI"],
 " must lie over every base neighbour of ",
 StyleBox["p", "TI"],
 " that the total graph reaches from ",
 StyleBox["x", "TI"],
 ", each exactly once."
}], "Notes",ExpressionUUID->"6640ca98-4715-48da-8de1-ffd40b5582db"]
}, Open  ]],

