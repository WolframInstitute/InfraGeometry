Cell["\<\
A random connection over the square grid, and the same edges without the two \
over the base edge 45 \[Dash] 46 at the centre. Then four total vertices have \
no lift over that edge:\
\>", "ExampleText",ExpressionUUID->"ea9ac991-a8ef-4f2a-9bba-d4929265fba0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"xy", " ", "=", " ", 
     RowBox[{"AssociationThread", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{"GraphEmbedding", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"RandomInfraFiberedGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"\"\<VerticalVertexCount\>\"", " ", "->", " ", 
        RowBox[{"{", "2", "}"}]}], ",", " ", 
       RowBox[{"\"\<HorizontalEdgeCount\>\"", " ", "->", " ", "All"}], ",", 
       " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"conn", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"InfraFiberedGraphHighlight", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"{", "h", "}"}], ",", " ", 
        RowBox[{"\"\<BaseVertexCoordinates\>\"", " ", "->", " ", "xy"}], ",", 
        " ", 
        RowBox[{"PlotLabel", " ", "->", " ", 
         RowBox[{"InfraConnectionQ", "[", 
          RowBox[{"fib", ",", " ", "h"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"h", ",", " ", 
        RowBox[{"{", 
         RowBox[{"conn", ",", " ", 
          RowBox[{"InfraConnection", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"First", " ", "@", " ", "conn"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Sort", "[", 
                RowBox[{"First", " ", "/@", " ", 
                 RowBox[{"List", " ", "@@", " ", "#"}]}], "]"}], " ", "=!=", 
               " ", 
               RowBox[{"{", 
                RowBox[{"45", ",", " ", "46"}], "}"}]}], " ", "&"}]}], 
            "]"}]}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"07704111-c5b9-4091-8cfa-11def1a45e6d"],

