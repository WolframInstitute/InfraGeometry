Cell["\<\
Removing one edge from a complete matching leaves two fiber vertices without \
a lift.\
\>", "ExampleText",ExpressionUUID->"712226b5-bb23-4fe4-9345-cebd448b7519"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", " ", "@@@", " ", 
          RowBox[{"Tuples", "[", " ", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"3", ",", " ", "4"}], " ", "}"}]}], " ", "}"}], " ", 
           "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], "\n", 
      "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}], ",",
        " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], " ", "]"}]}], " ", 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"Rest", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", "connection"}]}], " ", "]"}]}], " ", 
      "]"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraConnection", "[", " ", 
        RowBox[{"fib", ",", " ", "All"}], " ", "]"}]}], " ", "]"}]}], " ", 
    "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f704489f-3bdf-45da-837b-61bdf7c40121"],

