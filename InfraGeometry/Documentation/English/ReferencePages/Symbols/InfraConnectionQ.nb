  FontSize->0.9 Inherited,ExpressionUUID->
  "64d7b7f9-35ad-4d6f-992b-031de0a37f62"],
 " is a connection of ",
 StyleBox["fib", "TI"],
 " when every edge of ",
 StyleBox["H", "TI"],
 " is a total edge between two different fibers, and every total vertex over ",
 StyleBox["p", "TI"],
 " has exactly one ",
 StyleBox["H", "TI"],
 "-neighbour over each base neighbour of ",
 StyleBox["p", "TI"],
 "."
}], "Notes",ExpressionUUID->"d755e522-2e03-4417-b5ab-edef9862d34a"],

Cell["\<\
The matching must cover the whole fibers. Matching only the total vertices \
that have a lift is not enough, and adjacent fibers of different sizes admit \
no connection.\
\>", "Notes",ExpressionUUID->"8a4774f1-a50e-41aa-a04e-b83392479d6e"],

Cell[TextData[{
 "The empty list gives ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["False"]], "paclet:ref/False"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fe531db4-e236-4963-99f6-3e16e88d11ca"],
