Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23027438-8180-4134-a266-602bfc31e324"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
