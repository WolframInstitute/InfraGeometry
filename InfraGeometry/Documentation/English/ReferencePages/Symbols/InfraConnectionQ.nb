Cell["InfraConnectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c7b23476-48fc-4e7b-bdf3-99c86a737ea7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db6e2ade-4fe4-43ad-b5e9-9b6a838d8286"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["connection", "TI"],
 " gives a perfect matching between the whole fibers over every base edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a05d617c-bccd-4283-9079-6988f04aef52"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["connection1", "TI"], ",", " ", 
      StyleBox["connection2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0f42d05a-1231-4b71-946d-47ffb0f33767"],
 "\[LineSeparator]",
 "tests every member of a nonempty collection."
}], "Usage",ExpressionUUID->"14bc7221-17aa-41fa-a555-cf3881acb0a3"],

Cell["\<\
Every chosen edge must be a transverse edge of the total graph.\
\>", "Notes",ExpressionUUID->"8b81db63-8542-495b-bf17-1b2123237dcc"],

Cell["\<\
Every total vertex over a base vertex must have exactly one chosen neighbour \
over each adjacent base vertex.\
\>", "Notes",ExpressionUUID->"fc232aa4-7453-4849-a6bc-928852d3db56"],

Cell["\<\
The condition includes fiber vertices without any available lift. Saturating \
only the vertices that have available lifts is insufficient.\
\>", "Notes",ExpressionUUID->"4edd761e-390e-4a7b-a618-a98934029907"],

Cell[TextData[{
 "An empty collection returns False; it does not establish existence. The \
object ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb03e1cd-c223-4a7b-a728-161ffff9d5bc"],
 " is distinct and can be valid when the base has no edges."
}], "Notes",ExpressionUUID->"e940edbb-1a64-406b-a4cc-18c6c8ca6ce5"],

Cell["\<\
An unsupported fibered graph or undecided member remains unevaluated.\
\>", "Notes",ExpressionUUID->"1768c39d-23cb-49f9-9544-f2debb21882c"]
}, Open  ]],

