Cell["InfraConnectionQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c503afb7-2c52-487a-8917-1ced45d7e8d3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    StyleBox["connection", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d3f071a9-ac24-4fdd-a2b9-21581887af20"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["connection", "TI"],
 " gives a perfect matching between the whole fibers over every base edge.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"24264e75-b477-4f47-9332-3edda4cc0972"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnectionQ"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnectionQ", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["fib", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["connection1", "TI"], ",", " ", 
      StyleBox["connection2", "TI"], ",", " ", "..."}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ab7aeee-68da-4d0d-8994-be1cccb32c4c"],
 "\[LineSeparator]",
 "tests every member of a nonempty collection."
}], "Usage",ExpressionUUID->"951d699e-f114-4d10-b568-67f4b1bc61e1"],

Cell["\<\
Every chosen edge must be a transverse edge of the total graph.\
\>", "Notes",ExpressionUUID->"8a1c3f15-1bf9-4308-9fd9-67ea455ea0ba"],

Cell["\<\
Every total vertex over a base vertex must have exactly one chosen neighbour \
over each adjacent base vertex.\
\>", "Notes",ExpressionUUID->"beb19ffe-1e1a-4612-86b1-c3d1568fd890"],

Cell["\<\
The condition includes fiber vertices without any available lift. Saturating \
only the vertices that have available lifts is insufficient.\
\>", "Notes",ExpressionUUID->"4d657b92-e63c-4e7d-aba0-35a001f4b491"],

Cell[TextData[{
 "An empty collection returns False; it does not establish existence. The \
object ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraConnection"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraConnection", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0310154b-517a-48ca-b9bc-7be6efe38a46"],
 " is distinct and can be valid when the base has no edges."
}], "Notes",ExpressionUUID->"2a3f1dc2-919b-487a-992f-365c7f98ed16"],

Cell["\<\
An unsupported fibered graph or undecided member remains unevaluated.\
\>", "Notes",ExpressionUUID->"79776bb9-d4fe-432e-95dd-4f2dffdce418"]
}, Open  ]],

