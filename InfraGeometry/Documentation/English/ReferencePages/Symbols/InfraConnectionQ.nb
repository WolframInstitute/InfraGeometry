Cell["\<\
Removing one edge from a complete matching leaves two fiber vertices without \
a lift.\
\>", "ExampleText",ExpressionUUID->"02b3fad8-c674-4e72-9992-0a649a9c154e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "1", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", " ", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Graph", "[", " ", 
        RowBox[{
         RowBox[{"Range", "[", " ", "4", " ", "]"}], ",", " ", 
         RowBox[{"UndirectedEdge", " ", "@@@", " ", 
          RowBox[{"Tuples", "[", " ", 
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"1", ",", " ", "2"}], " ", "}"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"3", ",", " ", "4"}], " ", "}"}]}], " ", "}"}], " ", 
           "]"}]}]}], " ", "]"}], ",", "\n", "      ", 
       RowBox[{"<|", " ", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], " ", "|>"}]}], "\n", 
      "    ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{"connection", " ", "=", " ", 
     RowBox[{"RandomInfraConnection", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", "Identity"}]}], 
      " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
   RowBox[{"{", " ", 
    RowBox[{
     RowBox[{"InfraFiberedGraphHighlight", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", "connection"}], " ", "]"}], ",", "\n", "    ", 
     
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", " ", 
        RowBox[{"Rest", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", "connection"}]}], " ", "]"}]}], " ", 
      "]"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", " ", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"RandomInfraConnection", "[", " ", 
        RowBox[{"fib", ",", " ", "All"}], " ", "]"}]}], " ", "]"}]}], " ", 
    "}"}]}], "\n", "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f8c3586b-e834-4f9f-bc98-21c5d0bbfd49"],

