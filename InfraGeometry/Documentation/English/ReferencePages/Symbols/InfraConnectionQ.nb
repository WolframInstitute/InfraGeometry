Cell["\<\
The horizontal edges of the prism are a connection. Without one of them they \
are not: its two endpoints, drawn, lose a lift.\
\>", "ExampleText",ExpressionUUID->"583b1b70-e279-4c1a-9358-61146461dc9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<CycleProductBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"horizontal", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"EdgeList", "[", "total", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", "#"}]}], " ", "=!=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Last", " ", "@", " ", "#"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSubstrateHighlight", "[", 
      RowBox[{"total", ",", " ", 
       RowBox[{"{", 
        RowBox[{"InfraDensity", "[", 
         RowBox[{"total", ",", " ", 
          RowBox[{"List", " ", "@@", " ", 
           RowBox[{"First", " ", "@", " ", "horizontal"}]}]}], "]"}], "}"}]}],
       "]"}], ",", "\n", "    ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", "horizontal", "]"}]}], "]"}], ",", " ", 
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", 
        RowBox[{"Rest", " ", "@", " ", "horizontal"}], "]"}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"38afe2ea-93f6-4c3c-9f4e-f9ea5d21e946"],

