Cell["\<\
Two fibers of two vertices joined by a single edge. The edge is a matching \
that covers every total vertex with a lift, but not the whole fibers, so it \
is not a connection, and no connection exists:\
\>", "ExampleText",ExpressionUUID->"66ef2fc3-0198-4d9d-afcf-0ca82866db5c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedGraph", "[", 
      RowBox[{
       RowBox[{"Graph", "[", 
        RowBox[{
         RowBox[{"Range", "[", "4", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", " ", "<->", " ", "3"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"1", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"2", " ", "->", " ", "\"\<p\>\""}], ",", " ", 
         RowBox[{"3", " ", "->", " ", "\"\<q\>\""}], ",", " ", 
         RowBox[{"4", " ", "->", " ", "\"\<q\>\""}]}], "|>"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraConnectionQ", "[", 
      RowBox[{"fib", ",", " ", 
       RowBox[{"InfraConnection", "[", 
        RowBox[{"{", 
         RowBox[{"1", " ", "<->", " ", "3"}], "}"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"RandomInfraConnection", "[", 
      RowBox[{"fib", ",", " ", "All"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d6bd8145-b2d1-4841-8092-f9e9ed167f00"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"False", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"78b377ea-e44d-4967-ba8d-bf573e596c33"]
}, Open  ]]
