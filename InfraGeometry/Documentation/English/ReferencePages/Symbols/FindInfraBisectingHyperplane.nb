Cell["\<\
The bisector of two vertices at distance 6, drawn with its endpoints. It runs \
clear across the patch, separating one from the other.\
\>", "ExampleText",ExpressionUUID->"e0dbe8c6-ca6b-4840-beef-4fc92c5050d1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraBisectingHyperplane", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], " ", "->", " ", 
        "$InfraPlaneColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"99df42f8-9b2e-4a2c-bbbe-f7af4040235d"],

