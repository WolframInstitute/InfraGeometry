Cell[TextData[{
 "Every vertex of the bisector is equidistant from the two points, which is \
what ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/EquidistanceQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "cd5674f7-cb42-4c0a-84fb-8771a28432d4"],
 " tests."
}], "ExampleText",ExpressionUUID->"a7d99114-31ec-4f68-9ac3-3136c0b3eb46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"EquidistanceQ", "[", 
       RowBox[{
       "g", ",", " ", "a", ",", " ", "#", ",", " ", "b", ",", " ", "#"}], 
       "]"}], " ", "&"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1bbec054-c25b-4546-9b1e-1da05e3269e2"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f9596603-139a-468a-b200-261c18f458fb"]
