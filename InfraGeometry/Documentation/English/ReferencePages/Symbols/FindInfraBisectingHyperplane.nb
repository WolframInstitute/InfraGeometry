Cell[TextData[{
 "The bisector is ",
 StyleBox["H(p\:2081, p\:2082) = {v : d(p\:2081, v) = d(p\:2082, v)}", "TI"],
 ". In the plane it is the perpendicular bisector, a line; here it is a \
vertex set."
}], "Notes",ExpressionUUID->"19b32eaa-e498-49b8-ab94-754684592014"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, ",
 StyleBox["d(p\:2081, v) \[Minus] d(p\:2082, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 ". So the bisector is empty when ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 " is odd, and the slab {\[Minus]1, 1} is then the vertices at difference \
\[PlusMinus]1. On the mesh the bisector at odd distance is usually not \
empty."
}], "Notes",ExpressionUUID->"22e807d1-5440-45e8-9d97-debdde6ebf10"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ". On the grid it does; on the mesh a path can step across it from a vertex \
nearer ",
 StyleBox["p\:2081", "TI"],
 " to a vertex nearer ",
 StyleBox["p\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"5361492d-88a0-4a66-8b21-c99ac6a021d5"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ea41f0a-54d6-43c6-8836-089ee14787ea"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa4c3d74-3fb2-468a-9a2b-f4a6fb3ff209"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73c3b158-b337-498a-b272-207b5707bb75"],
 ". With the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79d10f53-6338-4965-88a6-ace68ad1a22f"],
 " the class has one set, the bisector or the slab itself."
}], "Notes",ExpressionUUID->"d3ac1cea-cebc-464d-ae50-cb6d2b48b976"],

