    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b53e5ce2-de51-4f25-8561-58b57713210b"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " vertex sets of the class named by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6662d0be-420e-4a21-b62d-d168abf3195d"],
 "."
}], "Usage",ExpressionUUID->"7941b3a7-d132-4f57-af5c-988e0c3a7bd6"],

Cell[TextData[{
 "The bisector is ",
 StyleBox["H(p\:2081, p\:2082) = {v : d(p\:2081, v) = d(p\:2082, v)}", "TI"],
 ". In the plane it is the perpendicular bisector, a line; here it is a \
vertex set."
}], "Notes",ExpressionUUID->"50ddb9a0-aa29-4483-b730-6e8e435b0627"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, ",
 StyleBox["d(p\:2081, v) \[Minus] d(p\:2082, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 ". So the bisector is empty when ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 " is odd, and the slab {\[Minus]1, 1} is then the vertices at difference \
\[PlusMinus]1. On the mesh the bisector at odd distance is usually not \
empty."
}], "Notes",ExpressionUUID->"61ac8e55-1d99-41c4-807d-8b520e6059bf"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ". On the grid it does; on the mesh a path can step across it from a vertex \
nearer ",
 StyleBox["p\:2081", "TI"],
 " to a vertex nearer ",
 StyleBox["p\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"51338735-d464-41e2-b80c-1b3132552918"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5ba2c839-362e-439a-915d-84e26ff6c260"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f4a45b4-bede-4d1f-9022-87f299c55909"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb1fa89f-c2aa-4178-a519-23c55004a5f7"],
 ". With the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8472aaa7-98f0-43cb-bc8a-6ec158e79515"],
 " the class has one set, the bisector or the slab itself."
}], "Notes",ExpressionUUID->"eee9e223-1d5b-46c1-ac9e-2e3435c301a5"],

