Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"252e325c-8ade-411a-ae4c-d12bf1f589a1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "990507b5-9d27-4c3c-ac65-cd1e268facaa"],
 "\[LineSeparator]",
 "gives the bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 ": the sorted list of the vertices equidistant from both.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5f5aa468-af9b-4fb9-a5b8-6aef217a65af"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b44783a-7f21-4f6e-ac07-a26ad08ae908"],
 "\[LineSeparator]",
 "gives the slab of the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p\:2081, v) \[Minus] d(p\:2082, v) \[LessEqual] \
hi", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3ec2d44c-15bb-4279-943c-82468efa69bd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66702c55-cfcd-4631-843f-bbdc4f19c9dd"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " vertex sets of the class named by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e17060f5-3af9-4570-88e4-80b258fa3468"],
 "."
}], "Usage",ExpressionUUID->"075180d8-7ace-4aa2-975b-d448230274a4"],

Cell[TextData[{
 "The bisector is ",
 StyleBox["H(p\:2081, p\:2082) = {v : d(p\:2081, v) = d(p\:2082, v)}", "TI"],
 ". In the plane it is the perpendicular bisector, a line; here it is a \
vertex set."
}], "Notes",ExpressionUUID->"b6fe3995-2870-442a-8fef-4e9498162319"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, ",
 StyleBox["d(p\:2081, v) \[Minus] d(p\:2082, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 ". So the bisector is empty when ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 " is odd, and the slab {\[Minus]1, 1} is then the vertices at difference \
\[PlusMinus]1. On the mesh the bisector at odd distance is usually not \
empty."
}], "Notes",ExpressionUUID->"466cdb69-0245-4dcd-822d-fea2423d9cd1"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ". On the grid it does; on the mesh a path can step across it from a vertex \
nearer ",
 StyleBox["p\:2081", "TI"],
 " to a vertex nearer ",
 StyleBox["p\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"701b428a-7c31-4401-8f1e-477403412764"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9511c14d-541d-4c69-9f2b-f2260ccdcdee"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46e343e6-16ba-439f-b864-48f5b4cdbf1a"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b667ad72-d92f-44f5-b1f7-a4a580dd1434"],
 ". With the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0793f490-58ea-476c-806f-e1fe5e018591"],
 " the class has one set, the bisector or the slab itself."
}], "Notes",ExpressionUUID->"ac2806e8-5cc4-42f4-befa-3208255a8a51"],

Cell[TextData[{
 "In the slab ",
 StyleBox["B", "TI"],
 " without ",
 StyleBox["p\:2081", "TI"],
 " and ",
 StyleBox["p\:2082", "TI"],
 ", a wall is a set ",
 StyleBox["W \[SubsetEqual] B", "TI"],
 " that separates ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ", induces a connected subgraph, and has no proper subset that does both. A \
connected minimal separator is a wall. On the square grid the minimal \
separators of a diagonal pair are staircases whose vertices meet only at \
corners, and that bisector has no wall. The walls are found by a greedy \
search: from a connected separating piece of ",
 StyleBox["B", "TI"],
 ", vertices are removed one at a time while the set stays connected and \
separating. With a count the walls are distinct; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33d32e0b-8571-49ad-a70a-b72bf6b34017"],
 " searches all of them, in time that can be exponential."
}], "Notes",ExpressionUUID->"c28de93b-1f85-4e87-bf96-aa145196ba1e"],

