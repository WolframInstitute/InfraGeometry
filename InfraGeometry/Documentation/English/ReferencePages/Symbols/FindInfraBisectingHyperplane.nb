Notebook[{

Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0d75f8a-e709-4685-9f7b-9a52b21d42d9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a708fcdb-2e6c-4bcd-a08f-17ca09e10c24"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "2"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de69958f-4334-4d5d-a1c6-b72d451a5f0f"],
 " as a sorted vertex list. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "508e8788-df2b-45c1-b106-9ad1337b6bcb"],
 " widens it to the slab ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], 
   StyleBox["o", "TI"], "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "2"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["h", "TI"], 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "259f6c9c-610e-4c2b-ad40-07e6da3ece69"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"26aa7a1a-eeac-4c73-addc-0bd64fe6df52"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "38162c68-3000-4466-bc08-3945f7105dfb"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4c8abf88-638a-417d-9556-c92a94ac7913"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f52b863-870a-4509-8e31-3772d36e5a1e"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "29e8e045-1a5b-4333-ac34-1f6be93525fe"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6d953707-3f63-4c4e-b604-2feb4ecb2589"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "370bff92-d739-42ee-97b6-ab134c72a695"],
 " the slab is the one vertex set."
}], "Usage",ExpressionUUID->"b5213a65-c30b-4327-9c23-45700fce2bb4"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"a40eeb05-af1a-4124-ac21-45353f8b7276"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ae26f92-a358-4665-9720-3f0d70c211d1"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraMidpoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8680c355-7ad3-4a77-988d-2c7dd99fabfe"],
 " return the two central vertices of each geodesic at odd distance, seen one \
dimension up."
}], "Notes",ExpressionUUID->"e945b3cb-c0dc-477c-8efb-7ec712268004"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69802249-18ed-43a9-ae8d-a852a5d00ea7"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "2"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33e339f8-1142-4b50-9377-2c41163c091d"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"83097f11-68fb-42c6-a864-943d0b0a4a50"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9c2bbda7-23b0-4914-bcf0-833252d6fd1f"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "04110e7b-d027-40a8-8f6a-77d00fc6f9e9"],
 " (default; the slab itself as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1032998c-b8cd-474b-acb7-aac202cbb94c"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6d23df1-1773-4a2c-b2b0-02f8a412a7c6"],
 ". Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4b631b6-d572-4c95-8e14-715b754ec9d7"],
 " is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b43e34a-4f6a-460b-9f2d-1f72a3d3fc58"],
 " names a class to search: it sees the vertices that can be peeled next and \
gives the ones to try, in order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3989f3b-84bc-43cb-937c-5c56a969e9ad"],
 " (default) is the canonical peel, so the count-less call is one minimal \
subset, deterministic; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c5b0876-cc62-4264-8609-7b71cb6fb9f0"],
 " peels in random order under an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ce6b0940-edda-4917-bd36-3f83f4250404"],
 "; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2159c68-d537-44b2-98eb-819e2e0d8a18"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node. The class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f9e05b3-5790-479f-9aca-a04a2956e003"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "799d4630-3ecb-47c7-9a71-46927311c7b4"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2e973a1-0caa-476f-ac5f-236e21f9d885"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"7e8f17cc-0fc8-4d64-90c5-8491160c5979"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"ebae9720-0e69-4000-802a-91f3dd3c6724"],

