Cell["\<\
Three connected separating sets in the slab {\[Minus]1, 1} at distance 5:\
\>", "ExampleText",ExpressionUUID->"0ce2887b-e2ed-4b46-9fd1-ff645274e20c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "5"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"GraphicsRow", " ", "@", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"wall", ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}]}], "}"}]}], "]"}], ",", "\n", 
      "    ", 
      RowBox[{"{", 
       RowBox[{"wall", ",", " ", 
        RowBox[{"FindInfraBisectingHyperplane", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
          RowBox[{"Properties", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], 
            "}"}]}]}], "]"}]}], "}"}]}], "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6919dcee-9821-4926-9ae1-35cc05579753"],

