Cell["\<\
Every vertex of the bisector is equidistant from the two points:\
\>", "ExampleText",ExpressionUUID->"86f5ca51-bcb9-4295-94df-893d9b8269d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "b", ",", " ", "#"}], "]"}]}], " ", "&"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"42cc9a93-868d-4ee2-970a-eba31de60906"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f14664cb-414b-4d17-a77b-b47a934c0d71"]
}, Open  ]],

Cell[TextData[{
 "On the mesh the bisector does not separate: after its removal ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " are still connected, so no subset of it separates them:"
}], "ExampleText",ExpressionUUID->"65adf6f7-bb15-427d-83df-2c716cc389cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bisector", " ", "=", " ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"ConnectedComponents", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "bisector"}], "]"}], "]"}], ",", " ", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "b"}], "}"}]}], "]"}], " ", "&"}], 
         ")"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"07f0fbd9-d619-457c-8f90-0adb896754ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d747d25a-b552-4ba5-a06c-70c285a1bb79"]
