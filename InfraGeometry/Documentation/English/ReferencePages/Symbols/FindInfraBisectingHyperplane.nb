  FontSize->0.9 Inherited,ExpressionUUID->
  "ab0cf5ce-f5a4-47cd-ac9d-3cca914c15b3"],
 "\[LineSeparator]",
 "gives the bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 ": the sorted list of the vertices equidistant from both.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7f86838a-de24-414f-9f7a-b5d724c31209"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ae89d997-b861-4bd1-9139-d5e62363dba4"],
 "\[LineSeparator]",
 "gives the slab of the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p\:2081, v) \[Minus] d(p\:2082, v) \[LessEqual] \
hi", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1e44cc40-6995-4ac1-8613-bfb04134341c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
