Cell["\<\
The bisector of two vertices at distance 6, drawn with its endpoints. It runs \
clear across the patch, separating one from the other.\
\>", "ExampleText",ExpressionUUID->"b8e2dfad-2ba6-4228-a0c9-28db90a17f97"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraHighlightGraph", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"FindInfraBisectingHyperplane", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], " ", "->", " ", 
        "$InfraPlaneColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"3ad69dee-93ac-4da0-a3a0-91998526a6ff"],

