Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c68b18a1-3040-463d-be6e-0c7d63cadac6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b61112f-6e5a-463f-b51a-cf4a68c63470"],
 "\[LineSeparator]",
 "gives the bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 ": the sorted list of the vertices equidistant from both.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3cbc2268-574d-4148-9384-ccfb6307d140"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6232366-5139-4c46-a3c1-cca40a5c6422"],
 "\[LineSeparator]",
 "gives the slab of the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p\:2081, v) \[Minus] d(p\:2082, v) \[LessEqual] \
hi", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"a275c3a9-6288-45c9-a2ea-a2a6960da243"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d35ae965-243b-4c04-8d91-e94c81ba9fe4"],
 "\[LineSeparator]",
 "gives a list of ",
 StyleBox["n", "TI"],
 " vertex sets of the class named by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Properties"]], "paclet:ref/Properties"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6c25e0da-45dc-4a84-b573-5130bd49df73"],
 "."
}], "Usage",ExpressionUUID->"c048cd43-c759-46f6-a22b-a0c1954824d1"],

Cell[TextData[{
 "The bisector is ",
 StyleBox["H(p\:2081, p\:2082) = {v : d(p\:2081, v) = d(p\:2082, v)}", "TI"],
 ". In the plane it is the perpendicular bisector, a line; here it is a \
vertex set."
}], "Notes",ExpressionUUID->"d02f589c-55a1-43f5-ac4d-57af95f73fd3"],

Cell[TextData[{
 "On a bipartite graph, such as the square grid, ",
 StyleBox["d(p\:2081, v) \[Minus] d(p\:2082, v)", "TI"],
 " has the parity of ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 ". So the bisector is empty when ",
 StyleBox["d(p\:2081, p\:2082)", "TI"],
 " is odd, and the slab {\[Minus]1, 1} is then the vertices at difference \
\[PlusMinus]1. On the mesh the bisector at odd distance is usually not \
empty."
}], "Notes",ExpressionUUID->"b52065ce-89a2-4125-82aa-d2552426a44b"],

Cell[TextData[{
 "The bisector need not separate ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ". On the grid it does; on the mesh a path can step across it from a vertex \
nearer ",
 StyleBox["p\:2081", "TI"],
 " to a vertex nearer ",
 StyleBox["p\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"4d345608-6963-4d58-a28b-2e9f7b3c531f"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " can be ",
 Cell[BoxData["n"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5423da-0f4d-4485-9e0c-02f072fcf560"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0018e832-b047-4ef4-86da-343a14e2a258"],
 " or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6076d672-224c-4eaf-996b-331f23a1a7ab"],
 ". With the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15e10d3e-5049-4586-b329-d54b9977b739"],
 " the class has one set, the bisector or the slab itself."
}], "Notes",ExpressionUUID->"fbf83136-7670-427e-9d68-9a4630201d64"],

Cell[TextData[{
 "In the slab ",
 StyleBox["B", "TI"],
 " without ",
 StyleBox["p\:2081", "TI"],
 " and ",
 StyleBox["p\:2082", "TI"],
 ", a wall is a set ",
 StyleBox["W \[SubsetEqual] B", "TI"],
 " that separates ",
 StyleBox["p\:2081", "TI"],
 " from ",
 StyleBox["p\:2082", "TI"],
 ", induces a connected subgraph, and has no proper subset that does both. A \
connected minimal separator is a wall. On the square grid the minimal \
separators of a diagonal pair are staircases whose vertices meet only at \
corners, and that bisector has no wall. The walls are found by a greedy \
search: from a connected separating piece of ",
 StyleBox["B", "TI"],
 ", vertices are removed one at a time while the set stays connected and \
separating. With a count the walls are distinct; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c938898a-3bc4-4239-a59b-49455571b3cf"],
 " searches all of them, in time that can be exponential."
}], "Notes",ExpressionUUID->"e41c2035-9c70-4a92-9e78-03197516ea25"],

