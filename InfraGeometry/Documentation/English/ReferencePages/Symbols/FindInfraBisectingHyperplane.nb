Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f235353-ffb4-4949-b7d8-c2bc0c9b5bb3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7a91c68-bade-40cb-9474-753852e11663"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "1"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "2"], ",", 
       StyleBox["v", "TI"]}], ")"}]}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d5352f2-29bd-47eb-91d5-e6cfb72a693c"],
 " as a sorted vertex list. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "48d56faf-bbaa-47e5-a46a-1dfe3d89be64"],
 " widens it to the slab ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["l", "TI"], 
    StyleBox["o", "TI"], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["h", "TI"], 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "681a9b5c-5b39-4c7b-8f25-7309b8f075aa"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"518eac53-09d5-42d2-8fd8-bc46e11ede91"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f0160ec-94a8-4b05-a026-b51359de2488"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2ead357-2088-4296-97cb-73acb7568148"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1efc6776-9c41-435e-aa29-b18de8f9691a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88a4624a-2c91-4f2e-be72-51c069eee961"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8eeb51d5-3e93-4ecb-b326-0665b38dd516"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27974cdd-894d-4b04-bd3d-ad11d025e6db"],
 " the slab is the one vertex set."
}], "Usage",ExpressionUUID->"8f8a7979-9ef1-41dd-b3f9-1088404385e9"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"648bbb90-6638-492e-a85b-9571bff36c85"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["p", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b2373123-f030-444f-8af2-254110358891"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraMidpoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1e869205-5531-4e29-be3a-2cf3fdefb3a2"],
 " return the two central vertices of each geodesic at odd distance, seen one \
dimension up."
}], "Notes",ExpressionUUID->"5aebb51c-1013-49b8-84d4-fd297d83b53f"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a826477-d2ab-400b-98c1-3c1b69005a14"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75811d9b-52fb-4967-8b3a-5faf06cd834b"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"9764f083-752d-488f-8454-8fb907458998"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bf4c2c1-7c09-4232-977b-a24344039678"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d28dcc8-43f8-4574-b881-698d6339807b"],
 " (default; the slab itself as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "169a8efb-5426-486e-9bea-43ac00794410"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "11ee5455-d987-4685-bede-b337d8c1336e"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb821641-cd0c-487b-bacc-0898e2c2d786"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b26fb669-b567-4dff-a70a-da3c69d38f3f"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20539fe9-a2df-422d-98fc-6e8e1b9eef4b"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b44c968-47b6-40d3-86e6-32a7a272dcea"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51817661-b58c-4e94-8aa5-ee657300afdf"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fffb553-6123-44ad-902f-455b5a88f20b"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c04ba435-81aa-4114-84f4-6cb06f64c499"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "34609712-f1d6-4327-8416-f358dd7af11b"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cbf07422-575d-4160-a717-aff13fd60cb1"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f1a230fc-454b-4158-8a73-1e354187e881"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31bd264d-deed-4d69-9f36-81f9935cff82"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8e399d6-85bf-4c0c-ab00-33455a984a87"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab185c2c-7b68-4fd3-8435-a4ab9b088fde"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "485ec6b1-f7e6-430b-b51c-d1e681aeef59"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"5cf30de8-393e-4892-ba99-52b5d7830baa"],

