  FontSize->0.9 Inherited,ExpressionUUID->
  "d44b8f01-4122-4f9a-8e94-e4ea2a173950"],
 "\[LineSeparator]",
 "gives the bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 ": the sorted list of the vertices equidistant from both.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0339bea7-1ee2-40c9-9ef9-888712546bd7"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lo", "TI"], ",", " ", 
      StyleBox["hi", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed9ff3aa-603a-46f9-8863-926ca0c5bc3e"],
 "\[LineSeparator]",
 "gives the slab of the vertices ",
 StyleBox["v", "TI"],
 " with ",
 StyleBox["lo \[LessEqual] d(p\:2081, v) \[Minus] d(p\:2082, v) \[LessEqual] \
hi", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1ad70b24-480b-4fcf-b514-4cf03fb8235e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
