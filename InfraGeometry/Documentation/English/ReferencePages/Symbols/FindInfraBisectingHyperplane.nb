Cell["\<\
Every vertex of the bisector is equidistant from the two points:\
\>", "ExampleText",ExpressionUUID->"0f9f60f4-efa7-4a41-b61d-df7648b1b35b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", " ", 
       RowBox[{"GraphDistance", "[", 
        RowBox[{"g", ",", " ", "b", ",", " ", "#"}], "]"}]}], " ", "&"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cdae6db6-06f2-4aae-88d5-f405533946ae"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0906e3c1-1ffc-4278-84d9-84da07083b11"]
}, Open  ]],

Cell[TextData[{
 "On the mesh the bisector does not separate: after its removal ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " are still connected, so no subset of it separates them:"
}], "ExampleText",ExpressionUUID->"cbdd75cb-97e4-45cb-b914-ddf8e2b2f09a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"RandomInfraPoint", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"InfraShell", "[", 
        RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
       RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"bisector", " ", "=", " ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"ConnectedComponents", "[", 
        RowBox[{"VertexDelete", "[", 
         RowBox[{"g", ",", " ", "bisector"}], "]"}], "]"}], ",", " ", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SubsetQ", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"{", 
             RowBox[{"a", ",", " ", "b"}], "}"}]}], "]"}], " ", "&"}], 
         ")"}]}]}], "]"}], ",", "\n", "   ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7a889e5c-1c30-4a52-84b5-79444936b18b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"364db41e-32f4-4ec6-b010-a67fa837756d"]
}, Open  ]],

Cell["\<\
On the grid the centre and its diagonal neighbour have 1369 minimal \
separators in the bisector, none of them connected, and no wall:\
\>", "ExampleText",ExpressionUUID->"85d63aed-4b84-4059-b711-34fc0c97fb29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"separators", " ", "=", " ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{
      "g", ",", " ", "45", ",", " ", "56", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", "\"\<Separating\>\"", "}"}]}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", "[", "separators", "]"}], ",", " ", 
     RowBox[{"Count", "[", 
      RowBox[{"separators", ",", " ", 
       RowBox[{"s_", " ", "/;", " ", 
        RowBox[{"ConnectedGraphQ", "[", 
         RowBox[{"Subgraph", "[", 
          RowBox[{"g", ",", " ", "s"}], "]"}], "]"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"FindInfraBisectingHyperplane", "[", 
      RowBox[{
      "g", ",", " ", "45", ",", " ", "56", ",", " ", "All", ",", " ", 
       RowBox[{"Properties", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], 
         "}"}]}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"20c1d6c7-fd27-4510-839c-cbed48d35925"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1369", ",", "0", ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"6635410b-058f-46cf-9e94-a84337142f00"]
}, Open  ]]
}, Open  ]],

