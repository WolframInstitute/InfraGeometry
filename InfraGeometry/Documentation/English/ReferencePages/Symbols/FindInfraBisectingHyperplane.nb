Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"16615ad6-9ea9-4776-b361-d1ff23a235f2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edecfcd0-cd11-4060-a732-99bfe7de9175"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "1"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "2"], ",", 
       StyleBox["v", "TI"]}], ")"}]}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4c9b276-62c7-4c9a-a2ac-f7336c60b21e"],
 " as a sorted vertex list. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a48f9678-fc03-4fe9-8c6f-1bd5ef733d74"],
 " widens it to the slab ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["l", "TI"], 
    StyleBox["o", "TI"], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["h", "TI"], 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2299887d-618e-4cab-ab9f-664bb5652463"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ae4e1a20-a59e-48ee-bb62-9f8e7920685a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "010b0ab9-3854-44f9-8ad9-d2d2274f5075"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dad5f237-d171-41dc-8ac9-5340e5c1ddd7"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07fc9049-4910-4054-b40d-4731836bddab"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87678f7f-d27a-457a-a2ed-0cc585b34e9d"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4abdcb9-6ee4-41a4-93cd-6a402eff254a"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bf8bdf9-4357-4487-a8da-60ca94e52687"],
 " the slab is the one vertex set."
}], "Usage",ExpressionUUID->"22a4dd57-052b-499a-9a68-3eb77eb4f159"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"cfb3985f-ad5b-4f96-9709-7e1ede0cbfac"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["p", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "486ce2ab-0daf-4911-ab89-30238e5ee3af"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraMidpoint", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "19a4c751-52aa-4306-a7df-594b2a654461"],
 " return the two central vertices of each geodesic at odd distance, seen one \
dimension up."
}], "Notes",ExpressionUUID->"773a8dd9-7929-4d6f-a7e4-9ee97f2a57f5"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f67e71d2-2a69-4bd6-b265-cf1c311a5263"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee7f09a5-183f-4676-ac3b-e69917ec57e3"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"d1d07c96-ca75-4b5e-854d-cbcae15cfc7c"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dbdd1fb0-c049-4c20-a498-836dd6180aa9"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73914b5b-4d78-49ea-8472-5f3b3f751fbe"],
 " (default; the slab itself as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3d14f58-8ae6-4e67-b1a8-2cab8cb5187d"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3650811-2194-4103-a200-9d321893729b"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d98cba2b-538d-43d0-b35f-352cf6c546c1"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "992cf977-65ca-4b71-8045-685177c15c01"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84ea48aa-f7ab-47c9-83dc-c91262931740"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09508851-1566-4a74-b706-4c47ca1e1800"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6e028480-a4c8-41b1-9e35-30ae14fabeb2"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97b2a964-64f2-48f3-a218-820e1fa4f157"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a7c222fe-37d9-45da-a8e9-81661682ebad"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57ae8976-a46b-426d-b694-b635674286f5"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "152f59a0-2136-4981-afe1-88fdff7da69e"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9eaa898-ed32-41aa-813c-735b00f46953"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0e7558c-7a35-49b9-875a-e45b7abd78aa"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9051c335-0d7f-40b5-a161-c5ef187c939a"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03b4d184-01e8-4ef6-a1f2-dd4956e4fc65"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a66f9404-3b0a-42c1-85ef-083d7f8e36a5"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"37e2b5f2-9734-4e84-a641-360a5f9c9bf2"],

