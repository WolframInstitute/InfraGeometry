Notebook[{

Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"75de368d-17c8-4e80-95f1-fc89869d028e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1ef1fa45-afb3-47a4-8288-4a051433b3ec"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "2"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3185213c-24b1-46c5-9d72-da79d4f8bd2d"],
 " as a sorted vertex list. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50081214-b0cc-48fa-a8c3-c507bbc9ed38"],
 " widens it to the slab ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], 
   StyleBox["o", "TI"], "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "2"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", 
   StyleBox["h", "TI"], 
   StyleBox["i", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "132b0850-1341-4528-b8b5-1e1836e31493"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"3099f414-4ccf-4457-8dca-490fdd5dca63"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraBisectingHyperplane",
      "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4574323d-dbb5-441d-8b55-8e4ccec12d89"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97f499e7-69ab-460b-8e70-f245a7d4131a"],
 " of exactly ",
 StyleBox["n", "TI"],
 " vertex sets or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93312866-b5a2-458b-9800-573ae3de01d7"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "912a03a5-22e2-4225-81b1-206bfddb3dfc"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8899b4e-342c-4777-a661-35bd9112b88b"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b246c4b-3d44-4d84-af0f-d23cf584fbd1"],
 " the slab is the one vertex set."
}], "Usage",ExpressionUUID->"65dc4524-e480-4a4e-ab2f-ddff84c7b7f3"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"ba3567f7-0c3e-4cd8-8198-3b5fbbbf98aa"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    SubscriptBox[
     StyleBox["p", "TI"], "2"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e87ec178-dd49-4179-aa12-cbf503ff7bd6"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasurement"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraMeasurement", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fb106afd-3d6d-47f6-af29-c69ab3fbf38d"],
 " with ",
 Cell[BoxData["\"\<Midpoint\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88e7fafe-64ad-42a6-a80f-8e9795e78a24"],
 " return the two central vertices of each geodesic at odd distance, seen one \
dimension up."
}], "Notes",ExpressionUUID->"6822697c-79e2-41dd-9543-ff124953d21a"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "298291f8-9047-4b43-9fa0-9bd744849940"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  RowBox[{"-", "1", "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "1"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["p", "TI"], "2"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[LessEqual]", "1"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad27a683-2215-4682-a7bb-5338b26e0fde"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"0934e205-e29b-4682-80de-63263d7cbf44"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22cb5788-e63d-4460-9c7e-11f43b4abb41"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "91975ad2-cd4c-4840-95ba-be31c3cf699d"],
 " (default; the slab itself as one vertex set), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2593ec3a-0e62-4704-b4da-1233cbbec515"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99750b3c-e7a7-450a-b18f-e8baf0feced6"],
 ". Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8496b0ff-c9b3-4ae8-9437-48503b86f0ad"],
 " is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09faf6db-972e-4b7f-bef4-f65db1eab22a"],
 " names a class to search: it sees the vertices that can be peeled next and \
gives the ones to try, in order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e58d4004-de2b-4748-960a-e08c6039e8de"],
 " (default) is the canonical peel, so the count-less call is one minimal \
subset, deterministic; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "540bb31e-8463-4ccd-befb-b4fd1a56fe90"],
 " peels in random order under an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f30f7483-9c87-483f-8f33-d344530c4755"],
 "; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a49f90d-2937-4830-bbda-2b9aa20769f8"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node. The class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dbad5f0-ce66-4022-bb83-a8b606b4298e"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b46f147e-2baf-46e6-8965-210eeef82b8c"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71b34cc1-77f2-49bd-b4f9-6f2fff3ebf1a"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors."
}], "Notes",ExpressionUUID->"70434a0b-38c0-4ef9-b792-98ff86be6f1f"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"daf96c47-1f9d-486c-b77d-97944622d05d"],

