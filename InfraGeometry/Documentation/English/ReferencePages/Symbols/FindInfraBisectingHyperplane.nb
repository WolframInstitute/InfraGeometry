Cell["\<\
The bisector of the centre and a vertex at distance 4, on the square grid and \
on the square mesh:\
\>", "ExampleText",ExpressionUUID->"7b6b4938-d92e-4e79-bade-c342f9783588"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"RandomInfraPoint", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"InfraShell", "[", 
           RowBox[{"a", ",", " ", "4"}], "]"}], ",", " ", 
          RowBox[{"RandomSeeding", " ", "->", " ", "1"}]}], "]"}]}], "}"}], ",",
       "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FindInfraBisectingHyperplane", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}]}], "}"}]}], "]"}]}], "]"}], ",",
     "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8746fdf2-dbb0-4a58-b7ae-e1a7a3d3adda"],

