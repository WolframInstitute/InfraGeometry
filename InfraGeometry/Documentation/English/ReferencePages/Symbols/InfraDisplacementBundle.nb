Cell[CellGroupData[{
Cell["InfraDisplacementBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fce715be-22b1-45cf-81b7-d6da9b3324e4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2e3612d-72f0-44f6-a2d2-2358e8abd148"],
 "\[LineSeparator]",
 "is the displacement bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["r", "TI"],
 ", projected to ",
 StyleBox["p", "TI"],
 ", two pairs adjacent iff their base points and their endpoints are equal or \
adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"fc97a840-7699-4819-b826-40a0014f9c37"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["p", "TI"],
 ", one vertex for each endpoint ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"02db9646-07c2-4645-a6ae-5b6bb9dfb876"],

Cell[TextData[{
 "A section is a displacement: it moves each vertex ",
 StyleBox["p", "TI"],
 " to a vertex at distance ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"5bc80464-b490-4741-b2a4-f569957479eb"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b0cd0221-2733-490b-a6a7-222b8fe8b524"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3e77d1da-c064-416d-a6b4-bfabf17ff46f"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4845234-6879-44c0-8536-362d24029f16"],
 " builds it once."
}], "Notes",ExpressionUUID->"cc60e799-af72-4a70-a44b-5acfb20b4577"],

