Cell["\<\
The fiber over the centre has no edges on the grid. On the mesh, a \
triangulation, its seven directions form a cycle:\
\>", "ExampleText",ExpressionUUID->"7f53da9d-fee9-4850-ab9d-90d31f9a1eba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"fib", " ", "=", " ", 
        RowBox[{"InfraDisplacementBundle", "[", 
         RowBox[{"g", ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraFiber", "[", 
       RowBox[{"fib", ",", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}], ",", 
    "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"be43467d-448f-46a5-8319-bdd1b02d982d"],

