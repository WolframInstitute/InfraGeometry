Cell["\<\
At scale 2 the fiber over 6 is the sphere of radius 2 about 6.\
\>", "ExampleText",ExpressionUUID->"8e0c7ca0-294b-4092-acb4-1df7156b5b20"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", " ", "7", " ", "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"InfraFiber", "[", 
         RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d800414f-3175-4eb5-ad8a-5b09e8c0e263"],

