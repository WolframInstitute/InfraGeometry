  TemplateBox[{
    Cell[
     TextData["InfraTotalSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e6abdca0-f030-4fd7-9913-80f8825e47dc"],
 ", ",
