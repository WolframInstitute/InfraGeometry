Cell["\<\
The fiber over the centre at scale 3 is the sphere of radius 3, drawn by the \
endpoints of its pairs:\
\>", "ExampleText",ExpressionUUID->"6e68f59e-0f01-4292-a47c-8e29e9dc8118"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Small\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"InfraSubstrateHighlight", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Last", " ", "/@", " ", 
           RowBox[{"VertexList", " ", "@", " ", 
            RowBox[{"InfraFiber", "[", 
             RowBox[{
              RowBox[{"InfraDisplacementBundle", "[", 
               RowBox[{"g", ",", " ", "3"}], "]"}], ",", " ", "c"}], 
             "]"}]}]}], ",", " ", "c"}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareGridGraph\>\"", ",", 
        " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"f3edd83b-fda5-4566-8465-95cf16f8c72b"],

