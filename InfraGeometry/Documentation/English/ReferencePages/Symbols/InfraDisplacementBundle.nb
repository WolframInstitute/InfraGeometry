  TemplateBox[{
    Cell[
     TextData["InfraProjection"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraProjection", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d814a5c3-8699-48bf-a1d3-15cef5e11f2a"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraFiber"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraFiber", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "26f79287-eb6d-48b7-9c7d-5c9f508a8e54"],
 " and the structural tests read it directly; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0f0d38c-7068-42f4-ad60-3d004b9c7877"],
 " gives it as a literal fibered graph."
}], "Notes",ExpressionUUID->"7f1b2bd0-17bd-4725-a515-d73444744ce4"],

