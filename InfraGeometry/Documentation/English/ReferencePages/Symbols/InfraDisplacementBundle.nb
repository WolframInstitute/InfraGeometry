Cell["\<\
The displacement bundle of the grid is a fibration but not a fiber bundle. \
The fibers have 4 vertices inside and 1 at the rim:\
\>", "ExampleText",ExpressionUUID->"421eaf13-2881-4a2b-95f3-f1ebac4560b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}],
        ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraFibrationQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"Counts", "[", 
      RowBox[{"VertexCount", " ", "/@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"InfraFibers", "[", "fib", "]"}]}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"90d529fe-a914-4205-95b7-41b4833b5e2c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "32"}], ",", 
     RowBox[{"4", "\[Rule]", "64"}]}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e4e86b8b-cbed-4881-ba12-370756bf612f"]
}, Open  ]],

Cell["\<\
On the square torus all fibers have 4 vertices, and still the bundle is not a \
fiber bundle: a pair has several lifts over a base edge.\
\>", "ExampleText",ExpressionUUID->"14506437-f3d0-421a-b669-f4e31879f1a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
        "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraEqualFiberSizesQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraUniqueEdgeLiftingQ", "[", "fib", "]"}], ",", " ", 
     RowBox[{"InfraFiberBundleQ", "[", "fib", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"44d07680-09e3-4f18-ad99-edfb6e79e264"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "False", ",", "False"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"13e1854a-ed2d-479c-9d04-a043ba25358e"]
}, Open  ]],

Cell["\<\
The endpoint map from the tangent bundle, a ray to its first and last vertex, \
is a bundle morphism:\
\>", "ExampleText",ExpressionUUID->"d96e2a02-8e93-47ac-a4a8-77828024b7e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", " ", "\"\<Small\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"displacement", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraBundleMorphismQ", "[", 
    RowBox[{"tangent", ",", " ", "displacement", ",", " ", 
     RowBox[{"InfraBundleMorphism", "[", 
      RowBox[{"tangent", ",", " ", "displacement"}], "]"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"a8ac9cd1-17df-403b-9d56-29495f594f67"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"1d87b081-17bf-40bf-8da7-ac8ce2564364"]
}, Open  ]]
}, Open  ]],

