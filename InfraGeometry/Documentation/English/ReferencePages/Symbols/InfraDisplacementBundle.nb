Cell["\<\
The displacement bundle of a grid at scale 1, the fiber over the vertex 6 \
drawn.\
\>", "ExampleText",ExpressionUUID->"10a97ca7-eaef-42c5-acf0-69562132c7d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraFiberedSubstrate", "[", 
      RowBox[{"\"\<GridDisplacementBundle\>\"", ",", " ", "\"\<Small\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"total", " ", "=", " ", 
     RowBox[{"InfraTotalGraph", "[", "fib", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"total", ",", " ", 
     RowBox[{"{", 
      RowBox[{"InfraDensity", "[", 
       RowBox[{"total", ",", " ", 
        RowBox[{"VertexList", " ", "@", " ", 
         RowBox[{"InfraFiber", "[", 
          RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "]"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"2661956d-aebb-4bd9-abcc-39556477e9ea"],

