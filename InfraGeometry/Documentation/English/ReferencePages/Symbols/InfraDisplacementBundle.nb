Cell[CellGroupData[{
Cell["InfraDisplacementBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4fbeb0b-c2fd-4b2c-b21a-4a67cfa2e9c8"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2671abd0-23b1-41c1-947c-e06421f1009d"],
 "\[LineSeparator]",
 "is the displacement bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["r", "TI"],
 ", projected to ",
 StyleBox["p", "TI"],
 ", two pairs adjacent iff their base points and their endpoints are equal or \
adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"94ac9de1-4f7e-4c62-8f7c-6a78d7eb56f2"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["p", "TI"],
 ", one vertex for each endpoint ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"eb2779db-0a52-4eee-b0cf-db2869d325f7"],

Cell[TextData[{
 "A section is a displacement: it moves each vertex ",
 StyleBox["p", "TI"],
 " to a vertex at distance ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"4a18d6f6-7502-43d7-b037-744a2c528c67"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "32eeadb9-0842-41c8-a70a-461596c30ba5"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b93136fa-578a-45a5-afef-c04df367fb69"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFibration"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFibration", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d02296e1-dd72-45d3-9718-68e278fa01c0"],
 " builds it once."
}], "Notes",ExpressionUUID->"52632210-ce24-497d-928e-8fe21c75e4c8"],

