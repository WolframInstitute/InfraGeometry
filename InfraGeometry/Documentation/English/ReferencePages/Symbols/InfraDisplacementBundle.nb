Cell["\<\
At scale 1 there is one total vertex for each oriented edge of the substrate:\
\
\>", "ExampleText",ExpressionUUID->"edbb40b4-bfb1-4442-af9e-69c7bf6045a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"InfraSubstrate", "[", 
        RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"VertexCount", " ", "@", " ", 
        RowBox[{"InfraTotalSpace", " ", "@", " ", 
         RowBox[{"InfraDisplacementBundle", "[", 
          RowBox[{"g", ",", " ", "1"}], "]"}]}]}], ",", " ", 
       RowBox[{"2", " ", 
        RowBox[{"EdgeCount", "[", "g", "]"}]}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"name", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<SquareGridGraph\>\"", ",", 
       " ", "\"\<SquareMeshGraph\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"33b59a92-b6f6-4869-9aac-238a02cd06b2"],

