Cell["\<\
The endpoint map from the tangent bundle is a bundle morphism. At scale 2 on \
the 4 x 4 grid the tangent bundle has 104 rays and 520 edges, the \
displacement bundle 68 pairs and 220 edges.\
\>", "ExampleText",ExpressionUUID->"49da2a91-f790-4ca5-a458-6c2b84df402d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"displacement", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "displacement", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "displacement"}], "]"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VertexCount", "[", "#", "]"}], ",", " ", 
         RowBox[{"EdgeCount", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"InfraTotalGraph", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"tangent", ",", " ", "displacement"}], "}"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7b6d0c4e-dfa6-4f22-bd05-7c6d475eff32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"104", ",", "520"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"68", ",", "220"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"af262624-8231-49ef-bf79-ec014043afec"]
}, Open  ]]
}, Open  ]],

