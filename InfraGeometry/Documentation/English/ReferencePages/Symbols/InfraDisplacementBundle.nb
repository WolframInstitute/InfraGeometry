Notebook[{

Cell[CellGroupData[{
Cell["InfraDisplacementBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c668b296-f39f-4892-b55c-120e5929d58f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e37f5a69-4c16-41f6-84e1-a93fdf9d5dcc"],
 "\[LineSeparator]",
 "is the displacement bundle of the graph ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": its total vertices are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["d(p, v) = r", "TI"],
 ", projected to ",
 StyleBox["p", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"5cb5a502-7fef-462c-8eac-1ecd2e91c465"],

Cell[TextData[{
 "The total vertices are ",
 StyleBox["{(p, v) : d(p, v) = r}", "TI"],
 ". Two pairs ",
 StyleBox["(p, v)", "TI"],
 " and ",
 StyleBox["(q, w)", "TI"],
 " are adjacent iff ",
 StyleBox["p = q", "TI"],
 " or ",
 StyleBox["p ~ q", "TI"],
 ", and ",
 StyleBox["v = w", "TI"],
 " or ",
 StyleBox["v ~ w", "TI"],
 ", and the pairs differ."
}], "Notes",ExpressionUUID->"58504b5a-4349-4dea-b91a-1a34030a98c6"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " is the sphere ",
 StyleBox["S\:1d63(p)", "TI"],
 ": one total vertex for each direction ",
 StyleBox["p \[RightArrow] v", "TI"],
 " at distance ",
 StyleBox["r", "TI"],
 ". Two directions at ",
 StyleBox["p", "TI"],
 " are adjacent iff their endpoints are. On a triangle-free graph such as the \
square grid the fiber at scale 1 has no edges."
}], "Notes",ExpressionUUID->"750214c9-2998-4b25-a6c8-5420a1e56520"],

Cell[TextData[{
 "At scale 1 the total vertices are the oriented edges of ",
 StyleBox["g", "TI"],
 ", 2 |",
 StyleBox["E", "TI"],
 "| of them."
}], "Notes",ExpressionUUID->"2f3b5478-4e51-4eab-9442-7ba57fa8c1d6"],

Cell[TextData[{
 "A section is a displacement: it moves each vertex ",
 StyleBox["p", "TI"],
 " to a vertex at distance ",
 StyleBox["r", "TI"],
 ". It is continuous, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraContinuousSectionQ"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraContinuousSectionQ", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9c057d63-9876-43dd-a193-d4d90eea5f0d"],
 ", iff neighbouring vertices move to equal or neighbouring vertices."
}], "Notes",ExpressionUUID->"46dfe530-d7c2-4ab7-a7a7-948fa487fc0f"],

Cell[TextData[{
 "The bundle is a fibration on the substrates, but not a fiber bundle: the \
spheres differ in size where ",
 StyleBox["g", "TI"],
 " is not homogeneous, and a pair has several lifts over a base edge."
}], "Notes",ExpressionUUID->"f672f233-b391-4774-907f-b7a1abeb3eee"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "22f273e7-5d5e-4241-af29-ce7aca0e3caf"],
 " is a symbolic object. ",
