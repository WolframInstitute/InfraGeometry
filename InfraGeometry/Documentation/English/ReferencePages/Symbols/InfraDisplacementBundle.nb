Cell["\<\
At scale 2 the fiber over 6 is the sphere of radius 2 about 6.\
\>", "ExampleText",ExpressionUUID->"dbcd8a77-46cf-482c-bae3-a70f8e7d2535"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"InfraFiber", "[", 
         RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"fb70e371-6784-405a-8f35-820054a396e4"],

