Cell["\<\
The endpoint map from the tangent bundle is a bundle morphism. At scale 2 on \
the 4 x 4 grid the tangent bundle has 104 rays and 520 edges, the \
displacement bundle 68 pairs and 220 edges.\
\>", "ExampleText",ExpressionUUID->"c883a505-9165-4a77-8e2a-df8157c28ce2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"tangent", " ", "=", " ", 
      RowBox[{"InfraTangentBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"displacement", " ", "=", " ", 
      RowBox[{"InfraDisplacementBundle", "[", 
       RowBox[{"g", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraBundleMorphismQ", "[", 
      RowBox[{"tangent", ",", " ", "displacement", ",", " ", 
       RowBox[{"InfraBundleMorphism", "[", 
        RowBox[{"tangent", ",", " ", "displacement"}], "]"}]}], "]"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"VertexCount", "[", "#", "]"}], ",", " ", 
         RowBox[{"EdgeCount", "[", "#", "]"}]}], "}"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"InfraTotalGraph", " ", "/@", " ", 
       RowBox[{"{", 
        RowBox[{"tangent", ",", " ", "displacement"}], "}"}]}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cfa60941-cd57-4f71-8514-a90fcf851887"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"104", ",", "520"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"68", ",", "220"}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"315f92c9-09b2-4bf5-97a8-0b897a5c2660"]
}, Open  ]]
}, Open  ]],

