Cell[CellGroupData[{
Cell["InfraDisplacementBundle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0f0ab3a2-9075-4bdb-a598-4cf966b922f9"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDisplacementBundle"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a426727-2259-4745-9f62-a700391e4ba0"],
 "\[LineSeparator]",
 "is the displacement bundle of ",
 StyleBox["g", "TI"],
 " at scale ",
 StyleBox["r", "TI"],
 ": the total vertices are the pairs {",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 "} with ",
 StyleBox["d", "TI"],
 "(",
 StyleBox["p", "TI"],
 ", ",
 StyleBox["v", "TI"],
 ") = ",
 StyleBox["r", "TI"],
 ", projected to ",
 StyleBox["p", "TI"],
 ", two pairs adjacent iff their base points and their endpoints are equal or \
adjacent.",
 "\n"
}], "Usage",ExpressionUUID->"4cbed40f-977b-4398-a0ba-aa6a9e188992"],

Cell["\<\
This is a particular Experimental construction in the Infra Fiber Bundles \
category. Its existing call forms remain available.\
\>", "Notes",ExpressionUUID->"2a75efb2-28ff-4475-9c64-bdeed82443f4"],

Cell[TextData[{
 "The fiber over ",
 StyleBox["p", "TI"],
 " is the sphere of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["p", "TI"],
 ", one vertex for each endpoint ",
 StyleBox["v", "TI"],
 "."
}], "Notes",ExpressionUUID->"2fe34db2-aec6-4df5-aea5-f300929fb863"],

Cell[TextData[{
 "A section is a displacement: it moves each vertex ",
 StyleBox["p", "TI"],
 " to a vertex at distance ",
 StyleBox["r", "TI"],
 "."
}], "Notes",ExpressionUUID->"8460e45d-9da8-4fce-b9db-4fe21202ca43"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraDisplacementBundle"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraDisplacementBundle", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "99d5553a-0bb2-433a-a3c0-fa1783ffadbd"],
 " is inert. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraTotalSpace"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraTotalSpace", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a37273a-6d89-4e9d-b27b-91857c88c038"],
 " builds its total graph on every call; ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraFiberedGraph"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/InfraFiberedGraph", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["fib", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "789c6f3c-4423-45d9-9a8a-51af0f165ae4"],
 " builds it once."
}], "Notes",ExpressionUUID->"a394e282-c0be-47cb-8daf-272d8c0aaf4d"],

