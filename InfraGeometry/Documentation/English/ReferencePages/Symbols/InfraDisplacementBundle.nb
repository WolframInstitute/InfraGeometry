Cell["\<\
At scale 2 the fiber over 6 is the sphere of radius 2 about 6.\
\>", "ExampleText",ExpressionUUID->"3bd3084b-f64d-4505-b288-cf1d55af21c6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fib", " ", "=", " ", 
     RowBox[{"InfraDisplacementBundle", "[", 
      RowBox[{"g", ",", " ", "2"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSubstrateHighlight", "[", 
    RowBox[{"g", ",", " ", 
     RowBox[{"{", 
      RowBox[{"Last", " ", "/@", " ", 
       RowBox[{"VertexList", " ", "@", " ", 
        RowBox[{"InfraFiber", "[", 
         RowBox[{"fib", ",", " ", "6"}], "]"}]}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5d619a1d-2f26-43a8-9997-21ba849349cc"],

