Cell["\<\
The three shapes on an 8 \[Times] 6 torus: vertex count, degree and diameter.\
\
\>", "ExampleText",ExpressionUUID->"a00a012f-210a-41eb-901e-1a56a0e86342"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"TorusTessellation", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "shape"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"shape", ",", " ", 
       RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Triangular\>\"", ",", 
       " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8c77c3a0-3455-44bd-a1e4-f2b9a30082e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Square\"\>", ",", "48", ",", 
     RowBox[{"{", "4", "}"}], ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Triangular\"\>", ",", "48", ",", 
     RowBox[{"{", "6", "}"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Hexagonal\"\>", ",", "96", ",", 
     RowBox[{"{", "3", "}"}], ",", "9"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"68f5f6f4-4d81-4ffa-9ab4-28037dda20fa"]
}, Open  ]]
}, Open  ]],

