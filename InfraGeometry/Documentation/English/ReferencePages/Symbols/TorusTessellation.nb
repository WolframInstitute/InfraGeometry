Cell[TextData[{
 "The square and triangular tori are Cayley graphs of \:2124/",
 StyleBox["m", "TI"],
 " \[Times] \:2124/",
 StyleBox["n", "TI"],
 ", with the steps \[PlusMinus]e\:2081, \[PlusMinus]e\:2082, and for the \
triangular torus also \[PlusMinus](e\:2081 + e\:2082). The honeycomb has two \
vertices per cell. Every one of the three is vertex-transitive, so every \
vertex sees the same torus."
}], "Notes",ExpressionUUID->"6c1d80f9-5b71-416b-8e62-b8659dcf13e8"],

Cell[TextData[{
 "The torus has no boundary, so no vertex is special and there is no rim to \
avoid. It pays for this with ",
 StyleBox["wraparound",
  FontWeight->"Bold"],
 ". A shell of radius ",
 StyleBox["r", "TI"],
 " grows like the plane's only until ",
 StyleBox["r", "TI"],
 " reaches half the shorter side; beyond that it meets itself and shrinks. \
Two vertices half-way round are joined by geodesics going both ways round. \
For plane geometry, use a patch from ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d7c3389-ffee-4bb4-a630-fbfeec3e00ad"],
 " instead."
}], "Notes",ExpressionUUID->"ebf4f869-f719-4801-a8a8-0c1dc483bf74"],

Cell[TextData[{
 "The graph has no coordinates; its layout is the default. ",
 Cell[BoxData["\"\<SquareTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69ccc331-f824-4183-b00e-d912ccc3d9a5"],
 ", ",
 Cell[BoxData["\"\<TriangularTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4995c4f7-c959-40b1-9dba-26c7717c99e4"],
 " and ",
 Cell[BoxData["\"\<HexagonalTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe9563ba-fd56-4886-97a0-8a3b2cd05720"],
 " in ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa30123e-540c-4b98-a32d-e1b5ea63593e"],
 " are these graphs placed on a torus of revolution. ",
 Cell[BoxData["Graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a023b177-deb6-462a-b525-f300542f5c42"],
 " options are passed on to the graph."
}], "Notes",ExpressionUUID->"1ed40a9f-4d90-45d7-924b-5048d9777a88"]
}, Open  ]],

