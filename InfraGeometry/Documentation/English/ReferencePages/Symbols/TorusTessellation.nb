Cell["\<\
The shell sizes on a 12 \[Times] 12 square torus. They grow by 4 at every \
step, as in the plane, up to radius 5; at radius 6 the shell meets itself, \
and it shrinks to the single antipode at radius 12.\
\>", "ExampleText",ExpressionUUID->"99b076f2-4a5f-4422-8662-ca6f30e89111"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "12"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "r"}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"321185f6-5b04-4fd2-9e63-127cc4380a2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "22", ",", 
   "20", ",", "16", ",", "12", ",", "8", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"368210d7-fe41-4a4a-b06c-6d780af0d7dc"]
}, Open  ]]
}, Open  ]],

