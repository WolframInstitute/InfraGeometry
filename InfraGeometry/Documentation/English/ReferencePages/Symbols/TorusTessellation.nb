Cell["\<\
Between two points half-way round the square torus there are two geodesics, \
one each way round.\
\>", "ExampleText",ExpressionUUID->"7aeb9bda-6e52-4fdf-ae9d-4daea691876e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
