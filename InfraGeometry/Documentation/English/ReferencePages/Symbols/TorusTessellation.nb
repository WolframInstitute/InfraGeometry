Cell["\<\
The shell sizes on a 12 \[Times] 12 square torus. They grow by 4 at every \
step, as in the plane, up to radius 5; at radius 6 the shell meets itself, \
and it shrinks to the single antipode at radius 12.\
\>", "ExampleText",ExpressionUUID->"ae0cb660-5dae-42de-8194-a5bef2c9b53b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "12"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "r"}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f048444e-4641-4975-93f9-d09eeb3e062d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "22", ",", 
   "20", ",", "16", ",", "12", ",", "8", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1e14edeb-95e1-4623-afcd-089913c0d158"]
}, Open  ]]
}, Open  ]],

