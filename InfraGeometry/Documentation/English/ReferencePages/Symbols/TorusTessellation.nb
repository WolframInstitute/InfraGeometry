  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["Every vertex looks the same.", "ExampleText",ExpressionUUID->"5ffb28be-0cd4-40bc-bdd1-2ce497d4330c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexTransitiveGraphQ", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Hexagonal\>\""}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"caf7a280-7bd6-4bb0-8b96-3d04ac245ccf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"c6d5e6ba-5709-42d1-ba19-0c2e293069f1"]
}, Open  ]],

Cell["The square torus is the Cartesian product of two cycles.", "ExampleText",ExpressionUUID->"8f8c048a-86de-4f7e-bf72-a32b06fbd69e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"TorusTessellation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"GraphProduct", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "\"\<Cartesian\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3565142c-e511-45bf-b4d1-e8670e811065"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fed14287-2239-4b08-92eb-d8355df9eb31"]
}, Open  ]],

Cell[TextData[{
 "The square torus substrate of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b388d5a4-2387-4a9a-9fd2-316abe49ebe5"],
 " is the 10 \[Times] 10 square torus."
}], "ExampleText",ExpressionUUID->"1ac3b375-fad3-479f-905c-670167e9dbbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"54bf93e9-4aaf-4231-bf6d-a073a7cc7103"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"b351b04b-bc6f-456c-a46d-58ad51baf66b"]
}, Open  ]]
}, Open  ]],

