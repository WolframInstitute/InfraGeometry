Cell["\<\
Between two points half-way round the square torus there are two geodesics, \
one each way round.\
\>", "ExampleText",ExpressionUUID->"3895e3a2-9f6e-419d-ba5e-4ed1a53b4b6f"],

Cell[CellGroupData[{

