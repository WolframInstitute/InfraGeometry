  "Properties & Relations", "ExampleSection",ExpressionUUID->
   "d18b1e1f-4c4c-49a5-bb54-1e5e145ddf4e"],
  $Line = 0; Null]], "ExampleSection",
 CellID->2123667759,ExpressionUUID->"0e0d5f37-f3c9-4474-a22b-9f10dcc8b438"],

Cell["Every vertex looks the same.", "ExampleText",ExpressionUUID->"c43f530d-e966-4f12-85df-b7f954f80848"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexTransitiveGraphQ", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Hexagonal\>\""}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"965c2d2e-c812-4e59-907b-b8b009dc7e70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e08cc0a5-73cc-43b1-9de6-480361b055b6"]
}, Open  ]],

Cell["The square torus is the Cartesian product of two cycles.", "ExampleText",ExpressionUUID->"93184296-65e9-47a6-a8e5-c8fc26d7fb47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"TorusTessellation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"GraphProduct", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "\"\<Cartesian\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"067897ca-a70f-44f7-b087-7d0e57c3c73d"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"536b44ba-5e52-4a42-aeef-72fbf2fc4758"]
}, Open  ]],

Cell[TextData[{
 "The square torus substrate of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2aece5f8-6505-4045-afd6-273348e738c5"],
 " is the 10 \[Times] 10 square torus."
}], "ExampleText",ExpressionUUID->"6d1b6f2f-c1e9-4286-84b8-9b59ee082a7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e390d38a-be63-49c8-ab16-6219a12d8c9e"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"87005a64-f6f3-4db9-b032-cbf0d16f0cf5"]
}, Open  ]]
}, Open  ]],

