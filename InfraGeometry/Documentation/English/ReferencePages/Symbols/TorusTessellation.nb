Cell[TextData[{
 "It is the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["TessellationGraph"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/TessellationGraph", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f8aae60-9f69-43f1-a563-c3c59f3a978b"],
 " of type {4, 4} and size {",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["n", "TI"],
 "}, and the 10 \[Times] 10 one is the substrate ",
 Cell[BoxData["\"\<SquareTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b232b697-fc76-4374-aaae-75ea4bbae781"],
 ":"
}], "ExampleText",ExpressionUUID->"e0106c05-a2f2-4b7f-9190-9d201b6ed05e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"IsomorphicGraphQ", "[", 
    RowBox[{
     RowBox[{"TessellationGraph", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "6"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"InfraSubstrate", "[", 
       RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
       "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"TorusTessellation", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
