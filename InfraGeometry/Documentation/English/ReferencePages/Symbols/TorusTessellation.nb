Cell["\<\
The three shapes on an 8 \[Times] 6 torus: vertex count, degree and diameter.\
\
\>", "ExampleText",ExpressionUUID->"2e29c1eb-95bd-4a0b-88a7-7c11f727d958"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"TorusTessellation", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "shape"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"shape", ",", " ", 
       RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Triangular\>\"", ",", 
       " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"44f8528d-994d-4b2c-9992-39c6b92331c3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Square\"\>", ",", "48", ",", 
     RowBox[{"{", "4", "}"}], ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Triangular\"\>", ",", "48", ",", 
     RowBox[{"{", "6", "}"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Hexagonal\"\>", ",", "96", ",", 
     RowBox[{"{", "3", "}"}], ",", "9"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b071e1d0-defa-4357-8d85-550192a2e739"]
}, Open  ]]
}, Open  ]],

