Cell["\<\
The shell sizes on a 12 \[Times] 12 square torus. They grow by 4 at every \
step, as in the plane, up to radius 5; at radius 6 the shell meets itself, \
and it shrinks to the single antipode at radius 12.\
\>", "ExampleText",ExpressionUUID->"af2163a3-74c3-41d1-85fd-be0c7d82e5ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "12"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"Keys", " ", "@", " ", 
       RowBox[{"InfraMeasurement", "[", " ", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "r"}], " ", "]"}], 
         ",", " ", "\"\<VertexDensity\>\""}], " ", "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"7fd09e6a-2186-490c-90ca-2e9bd0132f91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "22", ",", 
   "20", ",", "16", ",", "12", ",", "8", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"da962a52-5499-433b-b97c-9f403411e65a"]
}, Open  ]]
}, Open  ]],

