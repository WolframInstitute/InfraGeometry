Cell["\<\
The three shapes on an 8 \[Times] 6 torus: vertex count, degree and diameter.\
\
\>", "ExampleText",ExpressionUUID->"f9d14638-fdee-4ea8-8331-82bf5abedfeb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"TorusTessellation", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "shape"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"shape", ",", " ", 
       RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Triangular\>\"", ",", 
       " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b7e79971-a62b-4f77-9050-9ff5cc39ed30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
