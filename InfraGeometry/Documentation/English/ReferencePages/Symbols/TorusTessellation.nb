Cell[TextData[{
 "The square and triangular tori are Cayley graphs of ",
 StyleBox["\:2124\:2098 \[Times] \:2124\:2099", "TI"],
 " with the steps ",
 StyleBox["\[PlusMinus]e\:2081", "TI"],
 ", ",
 StyleBox["\[PlusMinus]e\:2082", "TI"],
 ", and for the triangular torus also ",
 StyleBox["\[PlusMinus](e\:2081 + e\:2082)", "TI"],
 ". All three are vertex-transitive: there is no rim and no special vertex."
}], "Notes",ExpressionUUID->"cb603553-72f3-432d-ae27-7b94d55512b1"],

Cell[TextData[{
 "The price is wraparound. On the square torus the shell of radius ",
 StyleBox["r", "TI"],
 " has ",
 StyleBox["4r", "TI"],
 " vertices, as in the plane, only while ",
 StyleBox["r", "TI"],
 " < min(",
 StyleBox["m", "TI"],
 ", ",
 StyleBox["n", "TI"],
 ")/2; past that it meets itself and shrinks. Two vertices half-way round are \
joined by shortest paths both ways round."
}], "Notes",ExpressionUUID->"e8571cfb-c29a-4f15-8239-e6dbdcc6a193"],

Cell[TextData[{
 "The graph has no coordinates. ",
 Cell[BoxData["\"\<SquareTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d14f1e8d-5cbe-48d1-8fa0-a73e4ba3bbf5"],
 ", ",
 Cell[BoxData["\"\<TriangularTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6c43a47a-46e7-4866-a324-99141f22614f"],
 " and ",
 Cell[BoxData["\"\<HexagonalTorusGraph\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef870a6a-ada8-4a6d-a22a-4b5300904858"],
 " of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ece5fcb2-70cb-4e5e-977d-aa957420c25e"],
 " are such tori placed on a torus of revolution. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c6ef4c1f-8c73-4aa8-a395-ee58d77c8b6d"],
 " options are passed on."
}], "Notes",ExpressionUUID->"674f48ea-abcc-42db-889a-cfc5605d367b"]
}, Open  ]],

