Cell["\<\
The shell sizes on a 12 \[Times] 12 square torus. They grow by 4 at every \
step, as in the plane, up to radius 5; at radius 6 the shell meets itself, \
and it shrinks to the single antipode at radius 12.\
\>", "ExampleText",ExpressionUUID->"4f4959d6-2f89-4dd4-b2e9-d61e1960d6ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "12"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "r"}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a8d751a4-0caa-48d7-bc0c-7d0369517929"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "22", ",", 
   "20", ",", "16", ",", "12", ",", "8", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9d74d9b3-466e-40f0-b342-5b1a37bb3409"]
}, Open  ]]
}, Open  ]],

