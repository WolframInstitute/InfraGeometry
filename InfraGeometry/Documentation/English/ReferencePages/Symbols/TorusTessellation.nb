Cell["Every vertex looks the same.", "ExampleText",ExpressionUUID->"eb49a823-4220-404f-bb56-1efd073200b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexTransitiveGraphQ", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Hexagonal\>\""}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c425cd84-6bd1-4a21-8a29-53a4fcf97d73"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"85d67421-1114-4a5e-9d1e-7168c3d35465"]
}, Open  ]],

Cell["The square torus is the Cartesian product of two cycles.", "ExampleText",ExpressionUUID->"55109ffb-92b2-483e-b68f-c9d57024c028"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"TorusTessellation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"GraphProduct", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "\"\<Cartesian\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"ea697a50-e3e2-4b5d-9daf-7fd6bb9745c1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"96c6e46f-f3a9-42a7-8d94-cfee7c6d4d24"]
}, Open  ]],

Cell[TextData[{
 "The square torus substrate of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9988a175-f625-472f-8862-101b1d26a1b0"],
 " is the 10 \[Times] 10 square torus."
}], "ExampleText",ExpressionUUID->"f36f85d9-937f-41c9-8675-94bc5b9834b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"6c15a3ab-e314-46ef-9b6b-867ae7a4cbec"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"39682c4d-9146-4757-a756-db7206cb5dcf"]
