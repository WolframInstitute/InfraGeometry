Cell["\<\
The three shapes on an 8 \[Times] 6 torus: vertex count, degree and diameter.\
\
\>", "ExampleText",ExpressionUUID->"79c319d3-2202-438d-981d-66494db047f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"TorusTessellation", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "shape"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"shape", ",", " ", 
       RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Triangular\>\"", ",", 
       " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"10ad17d3-7ad1-41bd-bd7a-e34290b14d6f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
