Cell["\<\
The three shapes on an 8 \[Times] 6 torus: vertex count, degree and diameter.\
\
\>", "ExampleText",ExpressionUUID->"1aea056c-fea2-427f-8e72-cd050b9ea728"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"TorusTessellation", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "shape"}], "]"}]}], 
      "}"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"shape", ",", " ", 
       RowBox[{"VertexCount", "[", "g", "]"}], ",", " ", 
       RowBox[{"Union", " ", "@", " ", 
        RowBox[{"VertexDegree", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"GraphDiameter", "[", "g", "]"}]}], "}"}]}], "]"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"shape", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Triangular\>\"", ",", 
       " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d2dac3b6-df0f-4a2d-a40d-50535b150237"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\<\"Square\"\>", ",", "48", ",", 
     RowBox[{"{", "4", "}"}], ",", "7"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Triangular\"\>", ",", "48", ",", 
     RowBox[{"{", "6", "}"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"Hexagonal\"\>", ",", "96", ",", 
     RowBox[{"{", "3", "}"}], ",", "9"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"b44d56e4-67ba-4753-9f27-53a2d2455078"]
}, Open  ]]
}, Open  ]],

