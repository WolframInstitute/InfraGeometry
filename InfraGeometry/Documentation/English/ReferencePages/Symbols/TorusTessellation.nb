Cell["\<\
The shell sizes on a 12 \[Times] 12 square torus. They grow by 4 at every \
step, as in the plane, up to radius 5; at radius 6 the shell meets itself, \
and it shrinks to the single antipode at radius 12.\
\>", "ExampleText",ExpressionUUID->"482bffe4-8349-411d-8033-223890ef0b0a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"TorusTessellation", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"12", ",", " ", "12"}], "}"}], ",", " ", "\"\<Square\>\""}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraShell", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "r"}], "]"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d8576cd0-4635-4aa4-9279-df33cfff1092"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "4", ",", "8", ",", "12", ",", "16", ",", "20", ",", "22", ",", 
   "20", ",", "16", ",", "12", ",", "8", ",", "4", ",", "1"}], 
  "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e44ce225-24d0-4fdb-973a-31fa328d2ee1"]
}, Open  ]]
}, Open  ]],

