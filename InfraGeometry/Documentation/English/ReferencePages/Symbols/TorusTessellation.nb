Cell["Every vertex looks the same.", "ExampleText",ExpressionUUID->"afc1a931-5459-4f71-848c-5aa90eeaddf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexTransitiveGraphQ", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Hexagonal\>\""}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d7131910-e279-442b-84e6-e8234301a135"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0f96c3ca-4045-4d4b-b6e0-04253c3a8733"]
}, Open  ]],

Cell["The square torus is the Cartesian product of two cycles.", "ExampleText",ExpressionUUID->"a92f7551-c096-4775-9e77-e2dd6decf30b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"TorusTessellation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"GraphProduct", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "\"\<Cartesian\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b3d6322a-0efb-4dcf-b305-dde275ea023c"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a71d0bf0-11e8-4b36-a746-ec6f367e2c22"]
}, Open  ]],

Cell[TextData[{
 "The square torus substrate of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c531b5e4-9ffb-4f99-8462-dbf4abb52779"],
 " is the 10 \[Times] 10 square torus."
}], "ExampleText",ExpressionUUID->"cf047684-f010-4341-9eca-e87eb7d52770"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f31262eb-23a1-4404-8d74-77953fe0d58a"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"d1c6a5ba-4492-4a9c-8bd3-94ff852ba5f7"]
