Cell["\<\
Between two points half-way round the square torus there are two geodesics, \
one each way round.\
\>", "ExampleText",ExpressionUUID->"1cd51c46-123a-42b7-8d47-3e756ef92f41"],

Cell[CellGroupData[{

Cell[BoxData[
