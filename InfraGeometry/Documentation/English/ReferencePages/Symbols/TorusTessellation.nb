Cell["Every vertex looks the same.", "ExampleText",ExpressionUUID->"1c67d8bc-935b-4b37-95e7-ff12881ca9fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"VertexTransitiveGraphQ", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], "]"}], ",", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Hexagonal\>\""}], 
     "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d5e4b202-66c4-4110-b92e-7d78404f46cb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"eda61d30-1e28-4f3e-a275-67c704990abe"]
}, Open  ]],

Cell["The square torus is the Cartesian product of two cycles.", "ExampleText",ExpressionUUID->"7d9e8279-b17a-4a10-9983-7f234dd5d66c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"TorusTessellation", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "6"}], "}"}], ",", " ", "\"\<Square\>\""}], 
    "]"}], ",", " ", 
   RowBox[{"GraphProduct", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "8", "]"}], ",", " ", 
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "\"\<Cartesian\>\""}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"94391c50-7555-49d1-9351-4f927bd55fef"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"a5a6c8c1-c479-4bca-87f2-c3660128cf2e"]
}, Open  ]],

Cell[TextData[{
 "The square torus substrate of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSubstrate"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSubstrate", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "802214b1-21d1-4d93-8822-87420f6ef9ee"],
 " is the 10 \[Times] 10 square torus."
}], "ExampleText",ExpressionUUID->"4bfad127-53e4-418d-b645-e110f58cf86d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"InfraSubstrate", "[", 
     RowBox[{"\"\<SquareTorusGraph\>\"", ",", " ", "\"\<Small\>\""}], 
     "]"}]}]}], " ", "===", "\n", "  ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"EdgeList", " ", "@", " ", 
    RowBox[{"TorusTessellation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"10", ",", " ", "10"}], "}"}], ",", " ", "\"\<Square\>\""}], 
     "]"}]}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"f56309eb-4fe9-4605-a594-335445dff5b0"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"85a2089e-66d7-4591-b242-427e3cf55fd9"]
}, Open  ]]
