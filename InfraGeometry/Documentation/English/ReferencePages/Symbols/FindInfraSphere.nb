     RowBox[{"Length", " ", "/@", " ", 
      RowBox[{"FindInfraSphere", "[", 
       RowBox[{"g", ",", " ", "25", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
        RowBox[{"Properties", " ", "->", " ", 
