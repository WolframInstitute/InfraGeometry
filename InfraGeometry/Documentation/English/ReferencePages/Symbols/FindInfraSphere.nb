Cell["\<\
All four minimal connected separating subsets of the band 1 to 2 about the \
centre of a 5 by 5 grid.\
\>", "ExampleText",ExpressionUUID->"612b6962-5702-4415-868b-7c249af1b834"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0bc331d2-3cdf-4957-a5be-91eae14d2121"],

