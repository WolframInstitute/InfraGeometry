Cell[CellGroupData[{
Cell["FindInfraSphere", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"59e7ee10-807c-48d5-ad4a-b0da94264dae"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fadf5d37-9856-470d-b743-29e36fea7d5f"],
 "\[LineSeparator]",
 "gives a ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3993f988-2843-447e-a7f0-767ed3a7619c"],
 " of exactly ",
 StyleBox["n", "TI"],
 " inclusion-minimal connected subsets of the shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " that separate the side of ",
 StyleBox["c", "TI"],
 " from the far side.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8bae7333-ce87-465c-9e40-1249a645a069"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["r", "TI"], ",", " ", 
      StyleBox["s", "TI"]}], "}"}], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e106f66e-ea68-4525-96eb-69afbe0c058b"],
 "\[LineSeparator]",
 "takes the band from ",
 StyleBox["r", "TI"],
 " to ",
 StyleBox["s", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"0c625355-5086-4d2f-8c64-7d609f3a7305"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraSphere"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/FindInfraSphere", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a24c5fb-0ff6-4595-996c-9c66bc71a63d"],
 "\[LineSeparator]",
 "gives one such subset, the first by the default method."
}], "Usage",ExpressionUUID->"dd019708-225a-4489-a0f6-433fb20c4c1b"],

Cell[TextData[{
 "The count ",
 StyleBox["n", "TI"],
 " may be ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c05bbead-522e-4058-a320-076c6cff905e"],
 ", which gives up to ",
 StyleBox["n", "TI"],
 ", or ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63807c06-64b9-472a-b190-92b4558b1c8f"],
 "."
}], "Notes",ExpressionUUID->"f85572a1-472b-4e4a-9970-c4bd3434cf32"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf653dd4-bf07-49f5-8c60-177d7adcd8c5"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f15b249d-d61a-467b-abb4-ca23342e36e7"],
 " (default), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c761851d-e6aa-486e-aad1-940b2607c502"],
 " for the inclusion-minimal separating subsets that need not be connected, \
or ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "190d8131-1efd-4c12-acf0-78bf9e14d21b"],
 " for the level set as the one member."
}], "Notes",ExpressionUUID->"2a5a28b4-94ae-4391-983d-89c152d40ee6"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<NextVertexFunction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ceb37214-b415-43e4-a2cb-50da725f9977"],
 " sees the vertices that can be peeled next and gives the ones to try, in \
order. ",
 Cell[BoxData["Identity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc4f5743-b4e2-4af6-a0e0-4245fcd906d2"],
 " (default) is the canonical peel, so the count-less call is one minimal \
subset, deterministic; ",
 Cell[BoxData["RandomSample"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "73adba0f-447a-4fce-bed2-e4c619671fdd"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "892494f7-af65-45ab-9c4a-35a263f99c37"],
 "; ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", " ", 
     RowBox[{"UpTo", "[", "n", "]"}]}], "]"}], " ", "&"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "25dcb3a5-960f-4008-b6cb-9e808a9edf7f"],
 " keeps at most ",
 StyleBox["n", "TI"],
 " branches per node, and the result is then minimal among the survivors."
}], "Notes",ExpressionUUID->"d2b1f6af-2a86-44ec-a90b-0541d8745b4d"],

Cell[TextData[{
 "The search peels the shell vertex by vertex while it keeps separating. It \
is the specialised search behind ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSphere"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/InfraSphere", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "13153ed7-cc94-47a0-ad8e-65eb04ccf91f"],
 ", whose ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRepresentative"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/FindInfraRepresentative", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2ed53dd4-6930-485a-becd-694557335698"],
 " clause calls it. The family can be large: all members on a medium tiling \
take long."
}], "Notes",ExpressionUUID->"4435f1f3-b0ef-41d9-a947-f7e8c6e52f7a"],

Cell[TextData[{
 "When the shell does not separate, as on a torus band that wraps, the result \
is ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2f76856f-5387-460f-b629-62c0108cfb9b"],
 "."
}], "Notes",ExpressionUUID->"8959a61d-4729-409e-88b7-467f8e326938"]
}, Open  ]],

