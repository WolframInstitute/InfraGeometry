Cell["A pruning function caps the branches tried per node.", "ExampleText",ExpressionUUID->"82738fed-145e-4db9-a113-c539f4f9c125"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
   RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RandomSample", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}], 
  "]"}]], "Input",
