  FontSize->0.9 Inherited,ExpressionUUID->
  "83e323f9-905b-424c-a917-31ddedf63519"],
 " the subsets need not be connected, so they can be smaller."
}], "ExampleText",ExpressionUUID->"b12ce285-96d7-40ee-b569-f730c4197cfe"],

