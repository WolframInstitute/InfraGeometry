  FontSize->0.9 Inherited,ExpressionUUID->
  "d9c89763-5e02-4290-a8c1-57dc4d24fa2c"],
 " the subsets need not be connected, so they can be smaller."
}], "ExampleText",ExpressionUUID->"f576d301-4881-4009-9d9e-c180791ce89c"],

