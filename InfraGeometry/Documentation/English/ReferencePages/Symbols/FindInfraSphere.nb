Cell["A pruning function caps the branches tried per node.", "ExampleText",ExpressionUUID->"900746c0-06da-4f3f-913e-4c5f6ebb7c31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindInfraSphere", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", "13", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "All", ",", " ", 
   RowBox[{"\"\<NextVertexFunction\>\"", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"RandomSample", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"UpTo", "[", "1", "]"}]}], "]"}], " ", "&"}], ")"}]}]}], 
  "]"}]], "Input",
