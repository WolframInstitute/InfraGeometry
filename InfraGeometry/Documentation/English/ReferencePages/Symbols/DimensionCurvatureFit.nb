Cell[CellGroupData[{

Cell["Probe", "ExampleSubsection",ExpressionUUID->"40bd8dd2-ed94-4447-be5d-9ee824e91288"],

Cell["\<\
The same quotients read by the four probes. The probe moves the intercept and \
the factor of the slope:\
\>", "ExampleText",ExpressionUUID->"0440bbd9-9531-44da-9eb2-b7a3af77a9dd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"2", " ", "-", " ", 
          RowBox[{"0.1", " ", "r", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"probe", " ", "|->", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"DimensionCurvatureFit", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{"\"\<Probe\>\"", " ", "->", " ", "probe"}]}], "]"}]}], ",",
         " ", "0.001"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Ball\>\"", ",", " ", "\"\<Sphere\>\"", ",", 
       " ", "\"\<Tube\>\"", ",", " ", "\"\<TubeMantle\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4cc56498-406d-4ff9-86df-eec70bef5add"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Ball\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"Sphere\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.075`"}], "}"}]}], ",", 
   RowBox[{"\<\"Tube\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"TubeMantle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"4.`", ",", "0.075`"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"9818b57e-98be-4d9b-87ce-70dfe779045b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dimension", "ExampleSubsection",ExpressionUUID->"3e851aa6-0f62-41dc-a02b-a6e73873764e"],

Cell["\<\
With the dimension fixed at 2, only the curvature is fitted. The shell \
quotients of the sphere mesh, the free line and the line through the \
intercept 1, labelled by their curvatures:\
\>", "ExampleText",ExpressionUUID->"cde055a0-064a-4ae9-bff5-1c36abd5c7e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"free", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}], ",", " ", 
       
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#1", " ", 
            RowBox[{"(", 
             RowBox[{"#1", " ", "+", " ", "1"}], ")"}]}], ",", " ", "#2"}], 
          "}"}], " ", "&"}], " ", "@@@", " ", "data"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "32"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1.5"}], "}"}]}], "}"}]}], ",", "\n", 
       "      ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], ",", " ", 
            RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}]}], "}"}], ",",
           " ", "0.01"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", "1",
           " ", "-", " ", 
          RowBox[{
           RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
           RowBox[{"x", "/", 
            RowBox[{"(", 
             RowBox[{"3", " ", 
              RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}]}], ")"}]}]}]}], 
         ",", "\n", "      ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
           RowBox[{"x", "/", "6"}]}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "32"}], "}"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c66d33f0-3064-420c-8594-6ac116afae88"],

