Cell[TextData[{
 "Quotients of an exact ball expansion with ",
 StyleBox["d", "TI"],
 " = 2 and ",
 StyleBox["R", "TI"],
 " = 0.1 give these numbers back:"
}], "ExampleText",ExpressionUUID->"18e4f819-7da8-42a6-83b7-7fd3c4123013"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DimensionCurvatureFit", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"2", " ", "-", " ", 
       RowBox[{"0.1", " ", "r", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], "}"}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a226cb48-ed71-43b3-9cbd-9233722ea7a3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", "1.9999999999999991`"}], ",", 
   RowBox[{"\<\"ScalarCurvature\"\>", "\[Rule]", "0.0999999999999998`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"8536fbc5-c4fe-43d9-9286-b83131618508"]
}, Open  ]],

Cell["\<\
A bare list sits at the radii 0, 1, 2, \[Ellipsis]. Constant quotients 2 read \
as the flat plane:\
\>", "ExampleText",ExpressionUUID->"58eedcf6-76b4-421e-9d81-74759de3c3f6"],

