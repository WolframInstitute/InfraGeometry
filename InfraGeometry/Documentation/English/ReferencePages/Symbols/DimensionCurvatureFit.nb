Cell[TextData[{
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a19fcc-1798-42a0-b241-6084ff6e80b7"],
 " quotients carry their spread into the dimension and the curvature: here \
the mean profile over five vertices near the centre of the discretized plane. \
Fitted from radius 1 on the counting measure, the intercept is biased high by \
the small radii; the windowed fit of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40187657-93b7-4457-85ec-05abf8905e70"],
 " chooses its window by the residual."
}], "ExampleText",ExpressionUUID->"4ee6b05f-4bc4-4f8d-867c-5a08d5330ec4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraRepresentative", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraBall", "[", 
          RowBox[{
           RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}]}], 
        "]"}], ",", " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"qdata", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", 
         RowBox[{"MeanAround", " ", "/@", " ", 
          RowBox[{"Transpose", " ", "@", " ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"InfraMeasurement", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"InfraBall", "[", 
                RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
               " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"v", ",", " ", "sampleSet"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"r", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}]}],
          "]"}]}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}], 
           ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
        " ", "qdata"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "3.5"}], "}"}]}], "}"}]}], ",", " ", 
