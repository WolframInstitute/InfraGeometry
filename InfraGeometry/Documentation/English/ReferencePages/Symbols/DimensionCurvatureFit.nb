 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f98cc8a9-c28f-4ad2-b4a4-9e6dd1c1a4fb"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"032303bd-75ef-420e-9c6e-a515cff8d23c"],

