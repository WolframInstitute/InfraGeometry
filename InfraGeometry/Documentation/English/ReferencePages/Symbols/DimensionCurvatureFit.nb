Notebook[{

Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"585f7ddf-f47e-4403-bf65-75b36018dfa4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb64c26-0207-4a4c-bcd1-9e4b10fba7d0"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to log-difference quotients ",
 StyleBox["qi", "TI"],
 " at radii ",
 StyleBox["ri", "TI"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21d29165-79df-40f0-8a49-6f5919b047e3"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7a538b32-b21a-4bc3-b4c1-09d64cb6b44a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90803306-a212-4160-85b0-3e93f21a86d6"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"e3aecabf-e9a8-4470-a79c-802fcd495421"],

Cell[TextData[{
 "Definition: the fit is the least-squares line ",
 StyleBox["q = c1 + c2 x", "TI"],
 " through the points ",
 StyleBox["(x, q)", "TI"],
 " with ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature, by the \
expansion of the probe's volume."
}], "Notes",ExpressionUUID->"da11cc7e-1ce1-4d82-83b3-7236fb0fddb8"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 " the log-log slope of the ball volume is ",
 StyleBox["d log V / d log r = d \[Minus] R r\.b2 / (3(d + 2)) + O(r\:2074)", 
  "TI"],
 ". The quotient is therefore affine in ",
 StyleBox["r\.b2", "TI"],
 ", and a line through it reads ",
 StyleBox["d", "TI"],
 " as the intercept and ",
 StyleBox["R", "TI"],
 " as \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope. This is Bishop\[Dash]Gromov read as a measurement."
}], "Notes",ExpressionUUID->"da8f42bc-16af-4aff-abb6-c4060d2d1ab9"],

Cell[TextData[{
 "On a graph ",
 StyleBox["r", "TI"],
 " is an integer and the quotient is a difference across ",
 StyleBox["[r, r + 1]", "TI"],
 ", not a derivative. To first order in the curvature it is affine in ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not in ",
 StyleBox["r\.b2", "TI"],
 "; regressing on ",
 StyleBox["r\.b2", "TI"],
 " would leave an error linear in ",
 StyleBox["r", "TI"],
 " in the slope, and so in ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"8332bf7f-7da0-4394-8e42-3506a5ba0774"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6809d2d-68ec-44fd-bd33-edc871cc1bc2"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"ee1346fe-72f5-4f46-a9f8-188ab9d66154"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fb0d3476-e300-4e6b-9b77-1ab70d4d4437"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"01076e95-b6f9-4e8b-b0f6-9de2cbbba86a"],
     Cell["Volume", "TableText",
     FontWeight->Bold,ExpressionUUID->"d506ab88-5274-450d-80b4-70fdecbe4732"],
     Cell["Dimension", "TableText",
     FontWeight->Bold,ExpressionUUID->"1eb368a1-45a7-41b9-8567-a3499b26c4ba"],
     Cell["Curvature read", "TableText",
     FontWeight->Bold,ExpressionUUID->"4b14eafd-9e98-4564-8632-bafc00496489"]},
   {Cell[TextData[{
     Cell[BoxData["\"\<Ball\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "800476b3-bb44-48b0-8fd0-4528b018d6c5"],
     " (default)"
    }], "TableText",ExpressionUUID->"7c196f8a-8aa7-47ac-8f43-87068e7ca5fd"], 
    Cell[TextData[StyleBox[
    "V ~ r^d", "TI"]], "TableText",ExpressionUUID->
     "8c5e0ba0-83ab-4edf-ac8e-e332f34fd6bf"], Cell[TextData[StyleBox[
    "c1", "TI"]], "TableText",ExpressionUUID->
     "8bb8148d-d3ee-435d-80e9-a04c6d461b0d"], Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",ExpressionUUID->
     "f6adcdc6-52e9-4691-8d2c-0f68affafb29"]},
   {Cell[TextData[Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "977fc512-1b8c-4fcd-8dc9-f61919216c13"]], "TableText",ExpressionUUID->
     "47a55254-1d7b-4d1e-ac84-59b966bcb4e4"], Cell[TextData[StyleBox[
    "A ~ r^(d\[Minus]1)", "TI"]], "TableText",ExpressionUUID->
     "82dba65b-5871-4522-9e76-927cb855b3f8"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"b4307c0b-5d35-493a-9c26-e68c098a2af4"], 
    Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",ExpressionUUID->
     "f57db773-f40e-4a4b-90d6-c1c6c5a5efff"]},
   {Cell[TextData[Cell[BoxData["\"\<Tube\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "fe71095b-5062-4e5d-8ec0-7403ba17bf18"]], "TableText",ExpressionUUID->
     "90eeeacb-783b-4459-83cf-4abc163f16d2"], Cell[TextData[{
     StyleBox["T ~ s^(d\[Minus]1)", "TI"],
     ", about a geodesic"
    }], "TableText",ExpressionUUID->"7fd86bec-8aa5-4649-8be5-f24d64a23a78"], 
    Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"287010b4-5021-48ce-bf0b-6cbe126f209f"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",
     ExpressionUUID->"54b122eb-1f33-4feb-b428-5768091603e6"]},
   {Cell[TextData[Cell[BoxData["\"\<TubeMantle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bdbb4f2c-5e7d-4399-8e9c-1bb93aa9444b"]], "TableText",ExpressionUUID->
     "ad83c408-6df5-4973-9e86-d3b214b3f0f6"], Cell[TextData[StyleBox[
    "\[PartialD]T ~ s^(d\[Minus]2)", "TI"]], "TableText",ExpressionUUID->
     "62cdcf7f-1ca4-488d-b55e-be48a22a3dae"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 2"
    }], "TableText",ExpressionUUID->"a5d33fc4-c11a-4a16-b340-59041e5eecd9"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",
     ExpressionUUID->"5ee87460-6158-498f-aa58-964274152437"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{None}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"8549e574-e091-4399-a900-504ded0820d2"],

Cell[TextData[{
 "For the two tube probes the ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "480f33f2-02a1-441b-86c5-2be9aa963c76"],
 " entry holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", the scalar curvature plus the Ricci curvature along the core's direction ",
 StyleBox["v", "TI"],
 "; subtract a ball reading of ",
 StyleBox["R", "TI"],
 " over the same window to leave ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"78d247ef-ca99-4827-8ce1-3e5205299aa8"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cc72e203-53af-4ae8-a41b-ee11a33acfad"],
 " fixes the dimension and fits the slope alone. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "399a3e81-e8fe-4614-8adf-9f1f6d49aab1"],
 " fits both."
}], "Notes",ExpressionUUID->"44f78124-26da-464b-ae62-088b18c9ad4f"],

Cell[TextData[{
 "Every point given is fitted: the window is the caller's, chosen by slicing \
the quotients. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "31777f55-544e-48ee-88ea-4f84a5ee1000"],
 " chooses it automatically. The quotient convention is the caller's too: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e73c004c-c00d-4ece-b010-410f4782c065"],
 " of a profile, or the radius-consistent quotients that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "18aa8bbe-2ddc-45b6-bba0-c97dfdd15dc9"],
 " takes. ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f25681a-aa3e-4d5c-affc-51865c5d6396"],
 " quotients give ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c47fb72e-6122-4791-89ec-dcdff5551b9e"],
 " results."
}], "Notes",ExpressionUUID->"66dcb0e6-0296-4d3c-a1db-7fcfc020cd73"]
}, Open  ]],

