Cell[TextData[{
 "Quotients of an exact ball expansion with ",
 StyleBox["d", "TI"],
 " = 2 and ",
 StyleBox["R", "TI"],
 " = 0.1 give these numbers back:"
}], "ExampleText",ExpressionUUID->"e05d8fde-b0c6-4e89-a5de-b14e5f8a99df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DimensionCurvatureFit", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"2", " ", "-", " ", 
       RowBox[{"0.1", " ", "r", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], "}"}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"16376d07-c92c-4dbc-ad34-86333ffc8beb"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", "1.9999999999999991`"}], ",", 
   RowBox[{"\<\"ScalarCurvature\"\>", "\[Rule]", "0.0999999999999998`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"867b20cd-1d6c-45f2-b574-cc326538421f"]
}, Open  ]],

Cell["\<\
A bare list sits at the radii 0, 1, 2, \[Ellipsis]. Constant quotients 2 read \
as the flat plane:\
\>", "ExampleText",ExpressionUUID->"ea87f036-2293-4688-9ebb-f4c9104a2ac8"],

