   {Cell[TextData[{
     Cell[BoxData["\"\<Ball\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1380429b-b746-49b8-be0c-515621c41096"],
     " (default)"
    }], "TableText",ExpressionUUID->"35c82ca3-aa04-4b22-b765-c34b9cbd6b54"], 
    Cell[TextData[StyleBox[
    "V ~ r^d", "TI"]], "TableText",ExpressionUUID->
     "3dfe87dc-4e7e-4e72-b5ad-042988f35ecd"], Cell[TextData[StyleBox[
    "c1", "TI"]], "TableText",ExpressionUUID->
     "ce0594d7-96ab-465c-b425-cda7f129eb7e"], Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",ExpressionUUID->
     "08cd8ca1-d65e-4fd4-bf7c-57fe62cecd5f"]},
   {Cell[TextData[Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "19aa2498-856d-43a5-900f-0e816eb36990"]], "TableText",ExpressionUUID->
     "8db41b4f-6dd2-4ae9-b953-4d47fef5bf12"], Cell[TextData[StyleBox[
    "A ~ r^(d\[Minus]1)", "TI"]], "TableText",ExpressionUUID->
     "7df5cc28-a2b6-44da-ac38-048a7a944c5a"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"4f436892-b0cd-47f5-afb6-24cb58061d69"], 
    Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",ExpressionUUID->
     "04b3ba2d-a31b-4467-8bc4-2d4a6ee4effd"]},
   {Cell[TextData[Cell[BoxData["\"\<Tube\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "87b30b18-9653-42ad-ac96-dcef0abde1d6"]], "TableText",ExpressionUUID->
     "5131faab-e6b6-446a-afa1-08c298d1e0fb"], Cell[TextData[{
     StyleBox["T ~ s^(d\[Minus]1)", "TI"],
     ", about a geodesic"
    }], "TableText",ExpressionUUID->"1ec6cafd-0178-412b-99f5-29b8517422db"], 
    Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"3adc0ebb-1e56-4fda-b299-0d7f8c970bf5"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",
     ExpressionUUID->"6e60a492-2195-43eb-931e-5b3be361ab8b"]},
   {Cell[TextData[Cell[BoxData["\"\<TubeMantle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "22138dc5-ee03-4331-b5be-2e953a1639e0"]], "TableText",ExpressionUUID->
     "7093e763-bf94-45c2-b20a-ff0076380f85"], Cell[TextData[StyleBox[
    "\[PartialD]T ~ s^(d\[Minus]2)", "TI"]], "TableText",ExpressionUUID->
     "b9341114-485a-4ae9-aa85-87c49c9d2839"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 2"
    }], "TableText",ExpressionUUID->"ddbef704-a3af-4d4d-b809-382b8a931fc4"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",
     ExpressionUUID->"b0db2422-307a-4e87-bdaa-b160c142a399"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{None}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"83ed81d8-27f5-467f-a775-f5025d1abda8"],

Cell[TextData[{
 "For the two tube probes the ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a586e063-67f0-45c8-80a0-7ed3760fe80f"],
 " entry holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", the scalar curvature plus the Ricci curvature along the core's direction ",
 StyleBox["v", "TI"],
 "; subtract a ball reading of ",
 StyleBox["R", "TI"],
 " over the same window to leave ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"3b942bce-a3b0-4c29-9a48-13d9c4cd6da2"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b379b46-f3a1-4e79-ae26-c07bca5818dc"],
 " fixes the dimension and fits the slope alone. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cef4af30-e1dc-43a5-85a3-82016ee985bd"],
 " fits both."
}], "Notes",ExpressionUUID->"f2b0376c-c3f3-41b4-b094-f56892db7bbf"],

Cell[TextData[{
 "Every point given is fitted: the window is the caller's, chosen by slicing \
the quotients. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8c2dd72b-7be1-45df-a73e-3857441fb7bb"],
 " chooses it automatically. The quotient convention is the caller's too: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a7ed8615-33f7-4cba-b4b4-86cb0c4f0e08"],
 " of a profile, or the radius-consistent quotients that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c1bd8a5a-20f4-4484-bfd8-bcada1e7be5f"],
 " takes. ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9befa01b-e093-4a02-a735-f62cb93954b3"],
 " quotients give ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fe724d0-81bb-40eb-bc7c-1c507833151e"],
 " results."
}], "Notes",ExpressionUUID->"04a3b1d1-49c1-46a7-a10e-758f8080c700"]
}, Open  ]],

