Cell[TextData[{
 "For the tube probes ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c21f4368-0013-469f-950a-569527c96b90"],
 " holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", with ",
 StyleBox["v", "TI"],
 " the direction of the core geodesic. A ball reading of ",
 StyleBox["R", "TI"],
 " over the same window leaves ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"42a6f21b-7fc2-402e-82e9-301d25e00b11"],

