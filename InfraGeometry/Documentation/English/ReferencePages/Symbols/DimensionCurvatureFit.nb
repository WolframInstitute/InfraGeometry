Cell["Dimension", "ExampleSubsection",ExpressionUUID->"f0b1701a-7893-4234-baf9-1c5bb0099f6f"],

Cell["\<\
With the dimension fixed, only the slope is fitted: the free line in gray, \
the line through the intercept 2 dashed.\
\>", "ExampleText",ExpressionUUID->"45d30499-c405-4425-be61-cee7ad8eb396"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qdata", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "1.9"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "1.8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "1.7"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"free", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", "qdata", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"qdata", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], 
               ")"}]}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
          " ", "qdata"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "32"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1.5", ",", " ", "2.2"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
             RowBox[{"x", "/", 
              RowBox[{"(", 
               RowBox[{"3", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "+", 
                  " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{"2", " ", "-", " ", 
            RowBox[{
             RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
             RowBox[{"x", "/", "12"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", "32"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "}"}]}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"free", ",", " ", "fixed"}], "}"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"62c36d22-3af7-413e-82cf-81e9cdb0767c"],

