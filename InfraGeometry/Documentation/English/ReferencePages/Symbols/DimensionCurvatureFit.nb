Cell[CellGroupData[{

Cell["Dimension", "ExampleSubsection",ExpressionUUID->"65ea979f-e03b-44ad-858d-a06ffb29d24f"],

Cell["\<\
With the dimension fixed at 2, only the curvature is fitted. The shell \
quotients of the sphere mesh, the free line and the line through the \
intercept 1, labelled by their curvatures:\
\>", "ExampleText",ExpressionUUID->"bff5d1eb-b738-4f28-8776-bd86630e2e9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"InfraMeasurement", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraShell", "[", 
          RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
         " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}], 
      "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"free", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"data", ",", " ", 
       RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}], ",", " ", 
       
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#1", " ", 
            RowBox[{"(", 
             RowBox[{"#1", " ", "+", " ", "1"}], ")"}]}], ",", " ", "#2"}], 
          "}"}], " ", "&"}], " ", "@@@", " ", "data"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "32"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1.5"}], "}"}]}], "}"}]}], ",", "\n", 
       "      ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Round", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], ",", " ", 
            RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}]}], "}"}], ",",
           " ", "0.01"}], "]"}]}]}], "]"}], ",", "\n", "    ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", "1",
           " ", "-", " ", 
          RowBox[{
           RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
           RowBox[{"x", "/", 
            RowBox[{"(", 
             RowBox[{"3", " ", 
              RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}]}], ")"}]}]}]}], 
         ",", "\n", "      ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
           RowBox[{"x", "/", "6"}]}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "32"}], "}"}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"454888d1-b033-4f52-87ec-b51976950afe"],

