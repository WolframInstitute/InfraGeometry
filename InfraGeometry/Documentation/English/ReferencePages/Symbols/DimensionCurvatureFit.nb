Cell[TextData[{
 "For the tube probes ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9fbe346-906b-488f-b4da-306a41359b17"],
 " holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", with ",
 StyleBox["v", "TI"],
 " the direction of the core geodesic. A ball reading of ",
 StyleBox["R", "TI"],
 " over the same window leaves ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"99c5bbd1-08f1-437e-8722-eb6e4b74dbd6"],

