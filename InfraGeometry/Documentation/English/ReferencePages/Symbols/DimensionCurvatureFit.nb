Cell[TextData[{
 "Ball quotients against ",
 StyleBox["r(r + 1)", "TI"],
 " over the fitted window, and the fitted line, at the centre of a sphere \
mesh, the square tiling and a hyperbolic tiling. The slope falls, stays level \
and rises: positive, zero and negative curvature, the number above each \
plot."
}], "ExampleText",ExpressionUUID->"ea6b50a3-c5f8-4746-9f99-749f19b4558c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gr", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"nm", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",", "\n",
       "    ", 
      RowBox[{"{", 
       RowBox[{"obs", " ", "=", " ", 
        RowBox[{"VolumeGrowthObservables", "[", 
         RowBox[{"gr", ",", " ", 
          RowBox[{"InfraCenter", "[", "gr", "]"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"win", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}], ",", " ", 
        RowBox[{"quots", " ", "=", " ", 
         RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"fitData", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rad", ",", " ", 
            RowBox[{"quots", "[", 
             RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"rad", ",", " ", 
            RowBox[{"win", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"win", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"fit", " ", "=", " ", 
        RowBox[{"DimensionCurvatureFit", "[", "fitData", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], 
                ")"}]}], ",", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@",
            " ", "fitData"}], ",", " ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"All", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "3"}], "}"}]}], "}"}]}], ",", "\n", 
          "        ", 
          RowBox[{"AxesLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}], ",", 
          " ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Column", "[", 
            RowBox[{"{", 
             RowBox[{"nm", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{"fit", "[", "\"\<ScalarCurvature\>\"", "]"}], ",", 
                " ", "0.001"}], "]"}]}], "}"}], "]"}]}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"fit", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"fit", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
            RowBox[{"x", "/", 
             RowBox[{"(", 
              RowBox[{"3", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"fit", "[", "\"\<Dimension\>\"", "]"}], " ", "+", 
                 " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
