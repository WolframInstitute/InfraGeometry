Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3871ec0f-ad03-46e5-8c46-add321729c6b"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7383a8d9-97a2-4e79-b282-b64f5271979e"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97e9bf5d-e60f-4fdf-b183-48803393f0c2"],
 " fitted to the log-difference quotients ",
 StyleBox["qi", "TI"],
 " at the radii ",
 StyleBox["ri", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"9a8560fa-2e79-41e0-8f28-383c59186c40"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8de8c8b2-cb95-4369-bfce-ea975ee0a7c8"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"de880920-42f1-456a-9de9-30f7933e8036"],

Cell[TextData[{
 "The fit is the least-squares line ",
 StyleBox["q = c\:2081 + c\:2082 x", "TI"],
 " in ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature."
}], "Notes",ExpressionUUID->"c80d948f-01a1-4f8c-a035-dd07bf2b866d"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 ", the ball volume is ",
 StyleBox["\[Omega]d r\:1d48 (1 \[Minus] R r\.b2 / (6(d + 2)) + O(r\:2074))", 
  "TI"],
 ". So the log-log slope of the volume is ",
 StyleBox["d \[Minus] R r\.b2 / (3(d + 2))", "TI"],
 ": the intercept is ",
 StyleBox["d", "TI"],
 " and ",
 StyleBox["R = \[Minus]3(d + 2) c\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"b7ea692c-9df0-4bc8-b9d6-6409dc4dc2d9"],

Cell[TextData[{
 "A quotient of a graph is taken across ",
 StyleBox["[r, r + 1]", "TI"],
 ", so it is regressed on ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not on ",
 StyleBox["r\.b2", "TI"],
 "."
}], "Notes",ExpressionUUID->"0234089e-711a-4e2b-84a1-cb281454dca1"],

