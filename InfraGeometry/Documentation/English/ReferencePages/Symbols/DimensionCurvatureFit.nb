Notebook[{

Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7ae2f064-67f3-4c2b-90c0-a2e23c70d3cb"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "425f3270-1fad-416d-9d7f-7b59d08e7031"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to log-difference quotients ",
 StyleBox["qi", "TI"],
 " at radii ",
 StyleBox["ri", "TI"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4347e80-9333-4549-a1ef-9662e9f2fe4f"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"114dcdca-69af-49ae-94e9-c1fd341cf1b6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "44167262-f5b6-48e8-8ceb-19a4ea38df0b"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"ae54d00f-d9ae-45be-98e0-b0780b525f04"],

Cell[TextData[{
 "Definition: the fit is the least-squares line ",
 StyleBox["q = c1 + c2 x", "TI"],
 " through the points ",
 StyleBox["(x, q)", "TI"],
 " with ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature, by the \
expansion of the probe's volume."
}], "Notes",ExpressionUUID->"4f2a2d48-fef8-4cdb-93f5-2381a26bd3f0"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 " the log-log slope of the ball volume is ",
 StyleBox["d log V / d log r = d \[Minus] R r\.b2 / (3(d + 2)) + O(r\:2074)", 
  "TI"],
 ". The quotient is therefore affine in ",
 StyleBox["r\.b2", "TI"],
 ", and a line through it reads ",
 StyleBox["d", "TI"],
 " as the intercept and ",
 StyleBox["R", "TI"],
 " as \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope. This is Bishop\[Dash]Gromov read as a measurement."
}], "Notes",ExpressionUUID->"a891b64f-f5e4-4bc2-b3bb-afea0ec8e2d7"],

Cell[TextData[{
 "On a graph ",
 StyleBox["r", "TI"],
 " is an integer and the quotient is a difference across ",
 StyleBox["[r, r + 1]", "TI"],
 ", not a derivative. To first order in the curvature it is affine in ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not in ",
 StyleBox["r\.b2", "TI"],
 "; regressing on ",
 StyleBox["r\.b2", "TI"],
 " would leave an error linear in ",
 StyleBox["r", "TI"],
 " in the slope, and so in ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"144d865d-dad1-4840-8ea4-d73fbfe56541"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54a6135d-afb4-4fd1-b3fa-714d150f5247"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"6513126b-d6ca-46bc-b1da-aae698577b0d"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7423d323-5ffa-41ff-9b0c-0a414eca71c9"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"d16ff9b3-c451-477b-8497-2bce7f5bc2ab"],
     Cell["Volume", "TableText",
     FontWeight->Bold,ExpressionUUID->"b1d685da-01e5-4803-805c-617b7d541661"],
     Cell["Dimension", "TableText",
     FontWeight->Bold,ExpressionUUID->"66b1c3b6-3077-4cfd-8f83-a30fe950db61"],
     Cell["Curvature read", "TableText",
