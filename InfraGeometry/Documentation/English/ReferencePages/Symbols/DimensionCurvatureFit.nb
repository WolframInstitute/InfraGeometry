Cell[TextData[{
 "For the tube probes ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39ebd51d-6a81-44f6-a158-4f4668aac252"],
 " holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", with ",
 StyleBox["v", "TI"],
 " the direction of the core geodesic. A ball reading of ",
 StyleBox["R", "TI"],
 " over the same window leaves ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"773cc09d-0315-47e1-a66b-20961e5dea54"],

