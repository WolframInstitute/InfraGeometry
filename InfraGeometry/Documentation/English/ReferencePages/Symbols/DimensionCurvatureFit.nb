}], "ExampleText",ExpressionUUID->"2a681cd3-6b8f-499c-9ef6-395475546280"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"obs", " ", "=", " ", 
     RowBox[{"VolumeGrowthObservables", "[", 
      RowBox[{"g", ",", " ", "c"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"window", " ", "=", " ", 
      RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}], ",", " ", 
     RowBox[{"q", " ", "=", " ", 
      RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"q", "[", 
           RowBox[{"[", "r", "]"}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"window", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
          RowBox[{"window", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", "\n",
      "   ", 
     RowBox[{"KeyTake", "[", 
      RowBox[{"obs", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<BallDimension\>\"", ",", 
         " ", "\"\<BallScalarCurvature\>\""}], "}"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d8970b4d-bd44-487b-832e-b5c759d309e4"],

