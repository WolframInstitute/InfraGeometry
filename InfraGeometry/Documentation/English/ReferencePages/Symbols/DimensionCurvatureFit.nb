Cell["Dimension", "ExampleSubsection",ExpressionUUID->"916eb848-89ce-4344-9198-56cd4bc5f23b"],

Cell["\<\
With the dimension fixed, only the slope is fitted: the free line in gray, \
the line through the intercept 2 dashed.\
\>", "ExampleText",ExpressionUUID->"e08e6297-dc1a-4625-aee9-28b884e21a69"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qdata", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "1.9"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "1.8"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"5", ",", " ", "1.7"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"free", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", "qdata", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"fixed", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", 
      RowBox[{"qdata", ",", " ", 
       RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "2"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], 
               ")"}]}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
          " ", "qdata"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "32"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1.5", ",", " ", "2.2"}], "}"}]}], "}"}]}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", 
            RowBox[{
             RowBox[{"free", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
             RowBox[{"x", "/", 
              RowBox[{"(", 
               RowBox[{"3", " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"free", "[", "\"\<Dimension\>\"", "]"}], " ", "+", 
                  " ", "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
           RowBox[{"2", " ", "-", " ", 
            RowBox[{
             RowBox[{"fixed", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
             RowBox[{"x", "/", "12"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", "32"}], "}"}], ",", "\n", 
         "       ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"Gray", ",", " ", "Dashed"}], "}"}]}]}], "]"}]}], "]"}], ",",
      "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"free", ",", " ", "fixed"}], "}"}]}], "}"}]}], "]"}]], "Input",
