Notebook[{

Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b43bd5f-68b4-4b84-960b-b9ecfcd3dbab"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "70921454-65ba-4edc-a399-7b73c2c9ee0a"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to log-difference quotients ",
 StyleBox["qi", "TI"],
 " at radii ",
 StyleBox["ri", "TI"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdda1a34-fc14-4843-b582-7930451aeb94"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"539a5916-91b8-48b3-8033-33a0709d5f67"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8da79607-da60-4274-95ea-a6ae500817a9"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"af36a5bb-5215-4443-b0eb-aa29a0653108"],

Cell[TextData[{
 "Definition: the fit is the least-squares line ",
 StyleBox["q = c1 + c2 x", "TI"],
 " through the points ",
 StyleBox["(x, q)", "TI"],
 " with ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature, by the \
expansion of the probe's volume."
}], "Notes",ExpressionUUID->"86a9c1a0-2ecb-43be-92b9-7fe39334afa3"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 " the log-log slope of the ball volume is ",
 StyleBox["d log V / d log r = d \[Minus] R r\.b2 / (3(d + 2)) + O(r\:2074)", 
  "TI"],
 ". The quotient is therefore affine in ",
 StyleBox["r\.b2", "TI"],
 ", and a line through it reads ",
 StyleBox["d", "TI"],
 " as the intercept and ",
 StyleBox["R", "TI"],
 " as \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope. This is Bishop\[Dash]Gromov read as a measurement."
}], "Notes",ExpressionUUID->"0897b16f-542a-461c-8c02-6fe61ad49b69"],

Cell[TextData[{
 "On a graph ",
 StyleBox["r", "TI"],
 " is an integer and the quotient is a difference across ",
 StyleBox["[r, r + 1]", "TI"],
 ", not a derivative. To first order in the curvature it is affine in ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not in ",
 StyleBox["r\.b2", "TI"],
 "; regressing on ",
 StyleBox["r\.b2", "TI"],
 " would leave an error linear in ",
 StyleBox["r", "TI"],
 " in the slope, and so in ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"3353549b-4e7e-45ea-bb40-73ae8e620f4e"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3111cd3a-3456-44f8-b768-6a334b3de33c"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"1699a254-012e-4f19-aa3a-bd8382230bc7"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9066b565-0651-44c6-b8f8-70a22e3868c8"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"767f7cac-b6bd-4909-bce1-85e4b71b92c2"],
     Cell["Volume", "TableText",
     FontWeight->Bold,ExpressionUUID->"512d0d09-77bd-4907-8d9a-be4c8631ed52"],
     Cell["Dimension", "TableText",
     FontWeight->Bold,ExpressionUUID->"91dfb8cd-a9f7-4d03-9bf9-54933c18205c"],
     Cell["Curvature read", "TableText",
     FontWeight->Bold,ExpressionUUID->"c3cce179-0599-4692-8354-5f97426df786"]},
   {Cell[TextData[{
     Cell[BoxData["\"\<Ball\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "67a2cb46-a250-4cd2-8ec6-33375b7d84f0"],
     " (default)"
    }], "TableText",ExpressionUUID->"090afd39-f32c-42a7-9a96-9c9b2f4cae6f"], 
    Cell[TextData[StyleBox[
    "V ~ r^d", "TI"]], "TableText",ExpressionUUID->
     "d79aa32f-03bf-445e-8a66-feb3ae718d81"], Cell[TextData[StyleBox[
    "c1", "TI"]], "TableText",ExpressionUUID->
     "61cec47f-999f-4713-807e-d4613d6c9592"], Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",ExpressionUUID->
     "8c88c016-216f-4bc7-b5cb-bc9cb01f8ed5"]},
   {Cell[TextData[Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b4f4f1f4-c8be-455f-883c-d92ceddaa66d"]], "TableText",ExpressionUUID->
     "d6128abb-eaed-4629-ac83-832e3ccecd1a"], Cell[TextData[StyleBox[
    "A ~ r^(d\[Minus]1)", "TI"]], "TableText",ExpressionUUID->
     "18f816d6-df37-47f7-a990-aa29289421d4"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"ff7d83d9-8596-4adb-ad5e-8b7b7949e6bf"], 
    Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",ExpressionUUID->
     "8f8ac13c-edb7-4788-9b5a-90b08d256ebe"]},
   {Cell[TextData[Cell[BoxData["\"\<Tube\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "f1a98675-8900-4f41-be58-f0e2b56de245"]], "TableText",ExpressionUUID->
     "dcd48e08-64bd-4c1d-91bc-4c92c10396cb"], Cell[TextData[{
     StyleBox["T ~ s^(d\[Minus]1)", "TI"],
     ", about a geodesic"
    }], "TableText",ExpressionUUID->"eaacd488-6790-4e2e-bf3c-08d00ef6662f"], 
    Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"0fd113ae-2439-4b01-949b-193ff5c6f615"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",
     ExpressionUUID->"ac3a0ebb-de4c-4e2b-8938-c8a6f13b92c9"]},
   {Cell[TextData[Cell[BoxData["\"\<TubeMantle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "dfba3150-dd60-4617-9816-72aafaafaf04"]], "TableText",ExpressionUUID->
     "69290680-6011-4bd1-b570-2e487916671b"], Cell[TextData[StyleBox[
    "\[PartialD]T ~ s^(d\[Minus]2)", "TI"]], "TableText",ExpressionUUID->
     "270dde2f-6bfe-4e23-b237-2c98853ad3da"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 2"
    }], "TableText",ExpressionUUID->"ad7ec0d9-8c40-490b-a547-d23520e49feb"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",
     ExpressionUUID->"a8108544-a240-42e4-93f4-d86f72dbb106"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{None}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"a9ad98d2-f8b4-4ec2-8f33-4d03f41b917d"],

Cell[TextData[{
 "For the two tube probes the ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ea6f314-2d7a-44a3-8d77-c71ca639d420"],
 " entry holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", the scalar curvature plus the Ricci curvature along the core's direction ",
 StyleBox["v", "TI"],
 "; subtract a ball reading of ",
 StyleBox["R", "TI"],
 " over the same window to leave ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"b9ed375e-ab53-4a44-9cee-60da7fba34d5"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1dc01e36-2248-473d-8eef-d1c24d2911b5"],
 " fixes the dimension and fits the slope alone. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8e1aecbb-d924-4f5a-b531-af5767cc3823"],
 " fits both."
}], "Notes",ExpressionUUID->"819608e4-a156-498b-94c3-d8d78998f822"],

Cell[TextData[{
 "Every point given is fitted: the window is the caller's, chosen by slicing \
the quotients. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4063c6b-b2e1-4328-91cb-7c05c68775d0"],
 " chooses it automatically. The quotient convention is the caller's too: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a134935e-3e67-4b75-a222-c507c2ffcc05"],
 " of a profile, or the radius-consistent quotients that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "91c1cfaa-cd4e-4bec-a3c6-4b0bc73cf2f0"],
 " takes. ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "03057a0e-0bfb-44ef-9344-340da5f1d42d"],
 " quotients give ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc88986e-264a-48bb-996f-dd6e02784696"],
 " results."
}], "Notes",ExpressionUUID->"9a040f2e-3b49-4c72-aa9b-ad4251cc1d41"]
}, Open  ]],

