Cell[TextData[{
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "98fb9c17-1e1d-4e25-9a53-d3412a8971a7"],
 " quotients carry their spread into the dimension and the curvature: here \
the mean profile over five vertices near the centre of the discretized plane. \
Fitted from radius 1 on the full count, the intercept is biased high by the \
small radii; the windowed fit of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e3b3e1a7-85ab-4a80-af37-3ef2e1946033"],
 " reads 1.95 at the centre."
}], "ExampleText",ExpressionUUID->"e5aac167-464b-47bd-95b3-2027c07883b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraBall", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"qdata", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "8", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", 
         RowBox[{"MeanAround", " ", "/@", " ", 
          RowBox[{"Transpose", " ", "@", " ", 
           RowBox[{"BallVolumes", "[", 
            RowBox[{"g", ",", " ", "sampleSet", ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "8"}], "}"}]}], "]"}]}]}], "]"}]}], 
       "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], ")"}]}], 
           ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
        " ", "qdata"}], ",", " ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "3.5"}], "}"}]}], "}"}]}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], "]"}], 
     ",", "\n", "   ", 
     RowBox[{"DimensionCurvatureFit", "[", "qdata", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a98b1d59-e7c5-4869-a5f7-a4d2f326e3c0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   GraphicsBox[{{{
       {RGBColor[0.24, 0.6, 0.8], 
