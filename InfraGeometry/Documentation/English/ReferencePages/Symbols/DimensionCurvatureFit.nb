Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a0ed0530-c092-47b3-ba5f-725aa37f1d79"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4c03569-beed-4b9d-b17f-6ccc0aefe490"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0291dff1-9b3d-4bc7-ada3-77f020ddc485"],
 " fitted to the log-difference quotients ",
 StyleBox["qi", "TI"],
 " at the radii ",
 StyleBox["ri", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"218c4dcf-0635-4542-8fe6-ab8cb8f890b1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b970558-3b35-44c6-a7c8-43c41e8dbd20"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"656acde4-96e1-48fb-8376-98c62a3e6e5c"],

Cell[TextData[{
 "The fit is the least-squares line ",
 StyleBox["q = c\:2081 + c\:2082 x", "TI"],
 " in ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature."
}], "Notes",ExpressionUUID->"2befcbc7-dddb-4e79-bbd7-c2e65fbdd1bc"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 ", the ball volume is ",
 StyleBox["\[Omega]d r\:1d48 (1 \[Minus] R r\.b2 / (6(d + 2)) + O(r\:2074))", 
  "TI"],
 ". So the log-log slope of the volume is ",
 StyleBox["d \[Minus] R r\.b2 / (3(d + 2))", "TI"],
 ": the intercept is ",
 StyleBox["d", "TI"],
 " and ",
 StyleBox["R = \[Minus]3(d + 2) c\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"df79964c-7bac-4b30-ab69-f244c5e4a33d"],

Cell[TextData[{
 "A quotient of a graph is taken across ",
 StyleBox["[r, r + 1]", "TI"],
 ", so it is regressed on ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not on ",
 StyleBox["r\.b2", "TI"],
 "."
}], "Notes",ExpressionUUID->"aaf27d06-3c9d-46c7-91b2-e0404a075adc"],

Cell[TextData[{
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1a5c8482-218b-4d99-9dc4-9b9d947b096d"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"9f792103-3c61-4a48-8f62-579dd88d0028"],

