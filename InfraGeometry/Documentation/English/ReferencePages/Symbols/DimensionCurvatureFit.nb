Cell[TextData[{
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f063c52f-14bb-4fa0-a2cd-7093307abe1b"],
 " quotients carry their spread into the dimension and the curvature: here \
the mean profile over five vertices near the centre of the discretized plane. \
Fitted from radius 1 on the full count, the intercept is biased high by the \
small radii; the windowed fit of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "aa355eb4-47f0-4fb3-9f91-b1ca75286bb1"],
 " reads 1.95 at the centre."
}], "ExampleText",ExpressionUUID->"d4647575-d118-48f4-8d9d-1d3083e0bfda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sampleSet", " ", "=", " ", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"FindInfraBall", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}], ",", " ", "2"}], "]"}], ",", 
       " ", "5"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"DimensionCurvatureFit", " ", "@", " ", 
    RowBox[{"Transpose", "[", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", "8", "]"}], ",", " ", 
       RowBox[{"LogDifferenceQuotients", "[", 
        RowBox[{"MeanAround", " ", "/@", " ", 
         RowBox[{"Transpose", " ", "@", " ", 
          RowBox[{"BallVolumes", "[", 
           RowBox[{"g", ",", " ", "sampleSet", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "8"}], "}"}]}], "]"}]}]}], "]"}]}], "}"}],
      "]"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3653949a-82da-4b86-9db0-1dbb09ed124d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", 
    InterpretationBox[
     TemplateBox[{"2.58", "0.30"},
      "Around"],
     Around[2.582718378045757, 0.2992739400532348]]}], ",", 
   RowBox[{"\<\"ScalarCurvature\"\>", "\[Rule]", 
    InterpretationBox[
     TemplateBox[{"0.10", "0.11"},
      "Around"],
     Around[0.09618021241821899, 0.1116442651125354]]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"43dfd050-71fb-4734-a216-e4930f9fac17"]
}, Open  ]]
}, Open  ]],

