     TextData["Around"]], "paclet:ref/Around"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a8303966-53bd-47f3-ba5f-e93eaa63a3e4"],
 " results. The mean shell sizes over the 19 vertices of the ball of radius 2 \
about the centre of the square mesh read dimension 2 and curvature 0 within \
the error:"
}], "ExampleText",ExpressionUUID->"86ee52e6-c2c1-48e5-9153-af5b5c6d04fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"MeanAround", " ", "/@", " ", 
      RowBox[{"Transpose", " ", "@", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
           " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sample"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"DimensionCurvatureFit", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}], "]"}],
      ",", " ", 
     RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"747de5cd-38cf-4599-a132-a79b2757485f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
