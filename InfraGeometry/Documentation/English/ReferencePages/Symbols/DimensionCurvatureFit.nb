   RowBox[{"2.", ",", " ", "2.", ",", " ", "2.", ",", " ", "2."}], "}"}], 
  "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"983baa28-1cda-4468-9ce8-d2d55ec62031"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
