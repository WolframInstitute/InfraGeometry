Cell[TextData[{
 "Quotients of an exact ball expansion with ",
 StyleBox["d", "TI"],
 " = 2 and ",
 StyleBox["R", "TI"],
 " = 0.1 give these numbers back:"
}], "ExampleText",ExpressionUUID->"e7fd72ee-7d8f-4184-9aae-09884d0b4600"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DimensionCurvatureFit", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r", ",", " ", 
      RowBox[{"2", " ", "-", " ", 
       RowBox[{"0.1", " ", "r", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], "}"}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1cb0fe93-9255-4b37-aa93-e7f01b6e2d04"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", "1.9999999999999991`"}], ",", 
   RowBox[{"\<\"ScalarCurvature\"\>", "\[Rule]", "0.0999999999999998`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"da00a41c-00a4-4a1c-af2f-fb9348040ac9"]
}, Open  ]],

Cell["\<\
A bare list sits at the radii 0, 1, 2, \[Ellipsis]. Constant quotients 2 read \
as the flat plane:\
\>", "ExampleText",ExpressionUUID->"8be27357-2450-4a55-be6f-3befb5582079"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DimensionCurvatureFit", "[", 
