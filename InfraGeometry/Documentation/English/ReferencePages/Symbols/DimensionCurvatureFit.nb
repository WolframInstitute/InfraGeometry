Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"21f36aeb-04b4-4249-a360-1bf7054a2d8c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f67883a9-3f4a-409d-b903-4247fffbcc83"],
 "\[LineSeparator]",
 "gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "afdd865c-0d68-4c06-9030-0d7ce82ac5e8"],
 " fitted to the log-difference quotients ",
 StyleBox["qi", "TI"],
 " at the radii ",
 StyleBox["ri", "TI"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"803da303-d53d-4ca4-935a-6f38bd5322f0"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f40095e-d083-487e-8522-f950a286ba7d"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"47465d85-4294-48be-a339-8ec65bba944f"],

Cell[TextData[{
 "The fit is the least-squares line ",
 StyleBox["q = c\:2081 + c\:2082 x", "TI"],
 " in ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature."
}], "Notes",ExpressionUUID->"1569e3bc-8ccd-46a3-bdd8-cf8ed86ecda9"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 ", the ball volume is ",
 StyleBox["\[Omega]d r\:1d48 (1 \[Minus] R r\.b2 / (6(d + 2)) + O(r\:2074))", 
  "TI"],
 ". So the log-log slope of the volume is ",
 StyleBox["d \[Minus] R r\.b2 / (3(d + 2))", "TI"],
 ": the intercept is ",
 StyleBox["d", "TI"],
 " and ",
 StyleBox["R = \[Minus]3(d + 2) c\:2082", "TI"],
 "."
}], "Notes",ExpressionUUID->"03a22f59-9b00-49fa-8100-1ce06f7da162"],

Cell[TextData[{
 "A quotient of a graph is taken across ",
 StyleBox["[r, r + 1]", "TI"],
 ", so it is regressed on ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not on ",
 StyleBox["r\.b2", "TI"],
 "."
}], "Notes",ExpressionUUID->"13581323-2412-40a9-903f-b52003d9bc06"],

Cell[TextData[{
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b644ab5d-a9c1-4e78-91bb-834b8055a2e3"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"4d7de22b-66f3-4cd8-b0f5-a1ff771d8fcd"],

