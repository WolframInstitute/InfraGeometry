Cell[TextData[{
 "Quotients of an exact Bishop\[Dash]Gromov form, dimension 2 and curvature \
0.1, against ",
 StyleBox["r(r + 1)", "TI"],
 ", with the fitted line; the fit gives those numbers back."
}], "ExampleText",ExpressionUUID->"b2e4c886-e4d1-4823-bff1-80789622624b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qdata", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"2", " ", "-", " ", 
          RowBox[{"0.1", " ", "r", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"3", " ", 
              RowBox[{"(", 
               RowBox[{"2", " ", "+", " ", "2"}], ")"}]}], ")"}]}]}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"fit", " ", "=", " ", 
     RowBox[{"DimensionCurvatureFit", "[", "qdata", "]"}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", "1"}], 
               ")"}]}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "&"}], " ", "/@", 
          " ", "qdata"}], ",", " ", 
         RowBox[{"AxesLabel", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<r(r+1)\>\"", ",", " ", "\"\<q\>\""}], "}"}]}]}], 
        "]"}], ",", "\n", "     ", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fit", "[", "\"\<Dimension\>\"", "]"}], " ", "-", " ", 
          RowBox[{
           RowBox[{"fit", "[", "\"\<ScalarCurvature\>\"", "]"}], " ", 
           RowBox[{"x", "/", 
            RowBox[{"(", 
             RowBox[{"3", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"fit", "[", "\"\<Dimension\>\"", "]"}], " ", "+", " ",
                 "2"}], ")"}]}], ")"}]}]}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", "110"}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", " ", "->", " ", "Gray"}]}], "]"}]}], "]"}], ",",
      "\n", "   ", "fit"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b8eb2092-d71e-40db-a014-8ee7889f9bc0"],

