Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SphereMeshGraph\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"obs", " ", "=", " ", 
       RowBox[{"VolumeGrowthObservables", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"InfraCenter", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"win", " ", "=", " ", 
          RowBox[{"obs", "[", "\"\<BallWindow\>\"", "]"}]}], ",", " ", 
         RowBox[{"quots", " ", "=", " ", 
          RowBox[{"obs", "[", "\"\<BallLogDifferenceQuotients\>\"", "]"}]}]}],
         "}"}], ",", "\n", "      ", 
       RowBox[{
        RowBox[{"DimensionCurvatureFit", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rad", ",", " ", 
             RowBox[{"quots", "[", 
              RowBox[{"[", "rad", "]"}], "]"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"rad", ",", " ", 
             RowBox[{"win", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
