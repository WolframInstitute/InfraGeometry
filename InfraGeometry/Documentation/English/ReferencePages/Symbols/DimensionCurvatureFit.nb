     Around[0.025039234646656965`, 0.04559915065594046]]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"71796da8-8356-4df0-ae1b-cb8f0266074c"]
