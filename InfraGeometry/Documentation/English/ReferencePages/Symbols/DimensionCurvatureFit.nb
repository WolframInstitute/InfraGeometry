Cell[TextData[{
 "The shell quotients about the centre against ",
 StyleBox["r(r + 1)", "TI"],
 ", with the fitted line, on the square grid and on the sphere mesh. The grid \
reads dimension 2 and curvature 0; on the sphere the line falls, positive \
curvature:"
}], "ExampleText",ExpressionUUID->"fbf145af-acf8-4feb-aecf-f49da8bfc029"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"areas", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"InfraMeasurement", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"InfraShell", "[", 
             RowBox[{"c", ",", " ", "r"}], "]"}], ",", 
            " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"data", " ", "=", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "5", "]"}], ",", " ", 
           RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"fit", " ", "=", " ", 
        RowBox[{"DimensionCurvatureFit", "[", 
         RowBox[{"data", ",", " ", 
          RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}]}], 
         "]"}]}], "}"}], ",", "\n", "    ", 
      RowBox[{"Show", "[", "\n", "      ", 
       RowBox[{
