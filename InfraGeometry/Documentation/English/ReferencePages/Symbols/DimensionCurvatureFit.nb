 " quotients give ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Around"]], "paclet:ref/Around"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "14105cfa-3743-40e8-9afa-11fdacd78439"],
 " results. The mean shell sizes over the 19 vertices of the ball of radius 2 \
about the centre of the square mesh read dimension 2 and curvature 0 within \
the error:"
}], "ExampleText",ExpressionUUID->"bee623e5-9cba-4964-817c-f8aff61c7c32"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"sample", " ", "=", " ", 
     RowBox[{"Keys", " ", "@", " ", 
      RowBox[{"InfraMeasurement", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"InfraBall", "[", 
         RowBox[{"c", ",", " ", "2"}], "]"}], ",", 
        " ", "\"\<VertexDensity\>\""}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"MeanAround", " ", "/@", " ", 
      RowBox[{"Transpose", " ", "@", "\n", "    ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"InfraMeasurement", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"InfraShell", "[", 
            RowBox[{"v", ",", " ", "r"}], "]"}], ",", 
           " ", "\"\<CountingMeasure\>\""}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "sample"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "1", ",", " ", "6"}], "}"}]}], "]"}]}]}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"DimensionCurvatureFit", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", "5", "]"}], ",", " ", 
        RowBox[{"LogDifferenceQuotients", "[", "areas", "]"}]}], "}"}], "]"}],
      ",", " ", 
     RowBox[{"\"\<Probe\>\"", " ", "->", " ", "\"\<Sphere\>\""}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"be90188c-b8c5-4dab-aa0d-f1dcd0f4a5bc"],

