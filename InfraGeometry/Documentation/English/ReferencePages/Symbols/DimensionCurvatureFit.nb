Cell[CellGroupData[{

Cell["Probe", "ExampleSubsection",ExpressionUUID->"3322847c-133a-4e51-8323-4865345c828b"],

Cell["\<\
The same quotients read by the four probes. The probe moves the intercept and \
the factor of the slope:\
\>", "ExampleText",ExpressionUUID->"a08c35a7-162b-4cc6-9378-50c81ea3f459"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"2", " ", "-", " ", 
          RowBox[{"0.1", " ", "r", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"probe", " ", "|->", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"DimensionCurvatureFit", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{"\"\<Probe\>\"", " ", "->", " ", "probe"}]}], "]"}]}], ",",
         " ", "0.001"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Ball\>\"", ",", " ", "\"\<Sphere\>\"", ",", 
       " ", "\"\<Tube\>\"", ",", " ", "\"\<TubeMantle\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c6d1fac5-2fea-43be-a446-65a359f32d03"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Ball\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"Sphere\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.075`"}], "}"}]}], ",", 
   RowBox[{"\<\"Tube\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"TubeMantle\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"4.`", ",", "0.075`"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"117bacc1-5554-47fb-86f1-57fa4f692dbb"]
}, Open  ]]
