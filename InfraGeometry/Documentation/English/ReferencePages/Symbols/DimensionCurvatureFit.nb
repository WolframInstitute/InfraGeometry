Cell[CellGroupData[{

Cell["Probe", "ExampleSubsection",ExpressionUUID->"85b99ba4-9c08-4353-8497-9fcf07f365a4"],

Cell["\<\
The same quotients read by the four probes. The probe moves the intercept and \
the factor of the slope:\
\>", "ExampleText",ExpressionUUID->"940f5ee8-b983-4515-98e4-3896ff4762c5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", " ", 
         RowBox[{"2", " ", "-", " ", 
          RowBox[{"0.1", " ", "r", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r", " ", "+", " ", "1"}], ")"}], "/", "12"}]}]}]}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "3", ",", " ", "10"}], "}"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{
     RowBox[{"probe", " ", "|->", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Values", " ", "@", " ", 
         RowBox[{"DimensionCurvatureFit", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{"\"\<Probe\>\"", " ", "->", " ", "probe"}]}], "]"}]}], ",",
         " ", "0.001"}], "]"}]}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Ball\>\"", ",", " ", "\"\<Sphere\>\"", ",", 
       " ", "\"\<Tube\>\"", ",", " ", "\"\<TubeMantle\>\""}], "}"}]}], 
    "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"67190b57-eaad-4d81-b6a2-96ba0e4c347b"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Ball\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"Sphere\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.075`"}], "}"}]}], ",", 
   RowBox[{"\<\"Tube\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"3.`", ",", "0.1`"}], "}"}]}], ",", 
   RowBox[{"\<\"TubeMantle\"\>", "\[Rule]", 
    RowBox[{"{", 
