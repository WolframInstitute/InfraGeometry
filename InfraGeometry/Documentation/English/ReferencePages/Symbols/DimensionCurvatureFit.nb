Notebook[{

Cell[CellGroupData[{
Cell["DimensionCurvatureFit", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a4677718-c541-4113-aa3a-30e7d32b70f3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       StyleBox["r1", "TI"], ",", " ", 
       StyleBox["q1", "TI"]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       StyleBox["r2", "TI"], ",", " ", 
       StyleBox["q2", "TI"]}], "}"}], ",", " ", "\[Ellipsis]"}], "}"}], 
   "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1e57331-f78a-4832-adc4-3805d97b4296"],
 "\[LineSeparator]",
 "fits the dimension and the scalar curvature to log-difference quotients ",
 StyleBox["qi", "TI"],
 " at radii ",
 StyleBox["ri", "TI"],
 ", and gives ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", " ", 
    RowBox[{"\"\<ScalarCurvature\>\"", " ", "->", " ", "R"}]}], "|>"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b440fcbe-03a8-4df1-aae0-a3abf1f11655"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f0c3bd28-25f0-4fac-8c49-633bc279fa1a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["DimensionCurvatureFit"]], 
     "paclet:WolframInstitute/InfraGeometry/ref/DimensionCurvatureFit", 
     "WolframInstitute/InfraGeometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["q0", "TI"], ",", " ", 
     StyleBox["q1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0c7f2690-3e42-4279-8b8f-c5232aaf6257"],
 "\[LineSeparator]",
 "places the quotients at the radii 0, 1, 2, \[Ellipsis]."
}], "Usage",ExpressionUUID->"ce72126a-8549-4bc2-9d27-574b6eac1c25"],

Cell[TextData[{
 "Definition: the fit is the least-squares line ",
 StyleBox["q = c1 + c2 x", "TI"],
 " through the points ",
 StyleBox["(x, q)", "TI"],
 " with ",
 StyleBox["x = r(r + 1)", "TI"],
 ". The intercept gives the dimension and the slope the curvature, by the \
expansion of the probe's volume."
}], "Notes",ExpressionUUID->"5dd322e4-6c7b-4dcd-b4ff-9c6f91fef1ef"],

Cell[TextData[{
 "On a Riemannian manifold of dimension ",
 StyleBox["d", "TI"],
 " and scalar curvature ",
 StyleBox["R", "TI"],
 " the log-log slope of the ball volume is ",
 StyleBox["d log V / d log r = d \[Minus] R r\.b2 / (3(d + 2)) + O(r\:2074)", 
  "TI"],
 ". The quotient is therefore affine in ",
 StyleBox["r\.b2", "TI"],
 ", and a line through it reads ",
 StyleBox["d", "TI"],
 " as the intercept and ",
 StyleBox["R", "TI"],
 " as \[Minus]3(",
 StyleBox["d", "TI"],
 " + 2) times the slope. This is Bishop\[Dash]Gromov read as a measurement."
}], "Notes",ExpressionUUID->"134ffc7b-3521-41e8-8dcd-868e46f33d33"],

Cell[TextData[{
 "On a graph ",
 StyleBox["r", "TI"],
 " is an integer and the quotient is a difference across ",
 StyleBox["[r, r + 1]", "TI"],
 ", not a derivative. To first order in the curvature it is affine in ",
 StyleBox["r(r + 1)", "TI"],
 ", the square of the geometric-mean radius, not in ",
 StyleBox["r\.b2", "TI"],
 "; regressing on ",
 StyleBox["r\.b2", "TI"],
 " would leave an error linear in ",
 StyleBox["r", "TI"],
 " in the slope, and so in ",
 StyleBox["R", "TI"],
 "."
}], "Notes",ExpressionUUID->"b475bf6f-67f3-4eaa-9aee-9faf6c0c17f9"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9b88cbdd-c4e8-4e1b-b488-2825fd374801"],
 " names the volume the quotients came from:"
}], "Notes",ExpressionUUID->"ce81b7bb-109f-409f-b007-51e0d39068ac"],

Cell[BoxData[GridBox[{
   {Cell[TextData[Cell[BoxData["\"\<Probe\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cc971e51-7354-4c09-892d-98a512d2d972"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"7452f647-050d-4401-a568-55550a3ab04b"],
     Cell["Volume", "TableText",
     FontWeight->Bold,ExpressionUUID->"24edb8ec-070c-4d62-b51b-77f80aadad5e"],
     Cell["Dimension", "TableText",
     FontWeight->Bold,ExpressionUUID->"d020deda-669d-4192-80d0-f4e887e397cd"],
     Cell["Curvature read", "TableText",
     FontWeight->Bold,ExpressionUUID->"f7c846ea-670b-4930-926c-7cdcbc3836e7"]},
   {Cell[TextData[{
     Cell[BoxData["\"\<Ball\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1de71b70-200e-4963-8ee8-38c4ed6ab647"],
     " (default)"
    }], "TableText",ExpressionUUID->"3ee9ab1d-9475-4d77-bd31-e0121d0185ea"], 
    Cell[TextData[StyleBox[
    "V ~ r^d", "TI"]], "TableText",ExpressionUUID->
     "3e3be477-0e30-4df7-8dd1-da12fa4f048d"], Cell[TextData[StyleBox[
    "c1", "TI"]], "TableText",ExpressionUUID->
     "72c1f6fe-cfba-42fa-9985-4b59f4a65796"], Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",ExpressionUUID->
     "b809c378-4725-4016-a0dd-21e787b1cdad"]},
   {Cell[TextData[Cell[BoxData["\"\<Sphere\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9dacbe75-da01-4601-a845-cd83fc11e5f6"]], "TableText",ExpressionUUID->
     "6f4b84f8-d648-4145-8cc3-d9691d44dcb6"], Cell[TextData[StyleBox[
    "A ~ r^(d\[Minus]1)", "TI"]], "TableText",ExpressionUUID->
     "f92909e0-fa8e-4d76-8ce7-21d51a80c57c"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"0eff7544-fd78-43ea-be21-8453de44b792"], 
    Cell[TextData[StyleBox[
    "R = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",ExpressionUUID->
     "7fa6c4ab-ed3f-448d-96b5-4356d7ebe2aa"]},
   {Cell[TextData[Cell[BoxData["\"\<Tube\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "581c23f8-5f13-4a6a-b050-e5682b6800d5"]], "TableText",ExpressionUUID->
     "e53f7660-9ebb-4f88-8417-3af9a69027f2"], Cell[TextData[{
     StyleBox["T ~ s^(d\[Minus]1)", "TI"],
     ", about a geodesic"
    }], "TableText",ExpressionUUID->"486d445b-9f4c-4d7a-bc00-494795e240ed"], 
    Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 1"
    }], "TableText",ExpressionUUID->"c02409ef-ec9b-456f-b7f5-e1cb4165e34c"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 2) c2", "TI"]], "TableText",
     ExpressionUUID->"1dd0deef-982d-4308-880d-a5dffb4c7b70"]},
   {Cell[TextData[Cell[BoxData["\"\<TubeMantle\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "aaed6cdc-b8ec-402d-8253-cf1798d83c71"]], "TableText",ExpressionUUID->
     "cb69f842-d967-4460-a9a6-3be40c5c8f54"], Cell[TextData[StyleBox[
    "\[PartialD]T ~ s^(d\[Minus]2)", "TI"]], "TableText",ExpressionUUID->
     "6b91ac74-06f0-4454-b35c-f51b7241fe57"], Cell[TextData[{
     StyleBox["c1", "TI"],
     " + 2"
    }], "TableText",ExpressionUUID->"7d7d3670-1695-436b-a574-66e2200c8dd1"], 
    Cell[TextData[StyleBox[
    "R + Ric(v, v) = \[Minus]3(c1 + 1) c2", "TI"]], "TableText",
     ExpressionUUID->"ecf39bac-5345-4bc3-b16b-645e6acd6d43"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
  GridBoxDividers->{"Columns" -> {{None}}, "Rows" -> {{True}}},
  GridBoxSpacings->{"Columns" -> {{1.5}}, "Rows" -> {{0.7}}}]], "Text",Express\
ionUUID->"4b1b035d-138f-4362-89d5-b62af5e9c7d1"],

Cell[TextData[{
 "For the two tube probes the ",
 Cell[BoxData["\"\<ScalarCurvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f4a0c89-f0cd-4739-8a21-256a05556cc1"],
 " entry holds ",
 StyleBox["R + Ric(v, v)", "TI"],
 ", the scalar curvature plus the Ricci curvature along the core's direction ",
 StyleBox["v", "TI"],
 "; subtract a ball reading of ",
 StyleBox["R", "TI"],
 " over the same window to leave ",
 StyleBox["Ric(v, v)", "TI"],
 "."
}], "Notes",ExpressionUUID->"ebabc54e-2fc0-41a4-9b75-c03c5400b478"],

Cell[TextData[{
 "Option ",
 Cell[BoxData[
  RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d2867db3-ceea-472d-a30f-5e1137ad7cd4"],
 " fixes the dimension and fits the slope alone. The default ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa94af32-eeaf-455c-a21e-ac59b72f1c25"],
 " fits both."
}], "Notes",ExpressionUUID->"c3a5a848-d3c2-485f-9b35-a5e020350e61"],

Cell[TextData[{
 "Every point given is fitted: the window is the caller's, chosen by slicing \
the quotients. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d6578999-93a3-4abc-b9c5-823d6d683509"],
 " chooses it automatically. The quotient convention is the caller's too: ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LogDifferenceQuotients"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/LogDifferenceQuotients", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bbee4b1a-8119-43d6-8370-d73521f03ca2"],
 " of a profile, or the radius-consistent quotients that ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["VolumeGrowthObservables"]], 
    "paclet:WolframInstitute/InfraGeometry/ref/VolumeGrowthObservables", 
    "WolframInstitute/InfraGeometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "53ecc489-bcd1-4ff7-b1fb-f874ce17d835"],
 " takes. ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "702577c5-2a6b-4f27-bb29-ce4ffcacb623"],
 " quotients give ",
 Cell[BoxData["Around"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "264b85fa-f79e-4a2c-b2bd-27e2fb0ff284"],
 " results."
}], "Notes",ExpressionUUID->"1c8169ca-c7ef-41ae-8eb8-6e5ed73b2c74"]
}, Open  ]],

