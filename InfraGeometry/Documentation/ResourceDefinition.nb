Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"image", " ", "=", " ", 
     RowBox[{"ImageResize", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"Import", " ", "@", " ", 
        RowBox[{"SelectFirst", "[", "\n", "      ", 
         RowBox[{
          RowBox[{"{", "\n", "        ", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Quiet", " ", "@", " ", 
                RowBox[{"Check", "[", " ", 
                 RowBox[{
                  RowBox[{"NotebookDirectory", "[", "]"}], ",", 
                  " ", "\"\<\>\""}], " ", "]"}]}], ",", " ", "\"\<..\>\"", ",",
                " ", "\"\<..\>\"", ",", " ", "\"\<assets\>\"", ",", 
               " ", "\"\<emergent-triangle.png\>\""}], "}"}], " ", "]"}], ",",
             "\n", "        ", 
            RowBox[{"FileNameJoin", "[", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directory", "[", "]"}], ",", 
               " ", "\"\<InfraGeometry\>\"", ",", " ", "\"\<assets\>\"", ",", 
               " ", "\"\<emergent-triangle.png\>\""}], "}"}], " ", "]"}], ",",
             "\n", "        ", 
            RowBox[{"FileNameJoin", "[", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"DirectoryName", " ", "@", " ", 
                RowBox[{"DirectoryName", " ", "@", " ", "$InputFileName"}]}], 
               ",", " ", "\"\<InfraGeometry\>\"", ",", " ", "\"\<assets\>\"", 
               ",", " ", "\"\<emergent-triangle.png\>\""}], "}"}], " ", 
             "]"}]}], "\n", "      ", "}"}], ",", "\n", "      ", 
          "FileExistsQ"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"1500", ",", " ", "Automatic"}], "}"}]}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"ImagePad", "[", " ", 
    RowBox[{"image", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
